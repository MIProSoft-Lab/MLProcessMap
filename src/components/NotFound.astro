---
// The body of the "page not found" page, in one language.
import { defaultVersion } from '../lib/content';
import { useTranslations, href, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<h1>{t('notFound.title')}</h1>
<p class="muted prose">{t('notFound.text')}</p>
<p class="nf-actions">
  <a class="button primary" href={href(locale, defaultVersion)}>{t('home.cta-map')} →</a>
  <a class="button" href={href(locale, 'tailor')}>{t('home.cta-tailor')} →</a>
</p>
<p><a href={href(locale)}>{t('notFound.back')}</a></p>

<style>
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0;
  }

  .nf-actions .button {
    text-decoration: none;
  }
</style>
