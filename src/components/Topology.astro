---
// The process map of a PRM version: its groups, each a frame with the group's
// name on a tab, holding columns of processes coloured by origin.
//
// On the map page each process links to its page, opens in the process modal
// and has a place to show where a search matched. With compact (the printable
// PRM), the columns keep their number on paper and each process links to its
// part of the document (#process-P01) instead.
import { getProcess, getVersion, pick } from '../lib/content';
import { href, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  version: string;
  compact?: boolean;
}

const { locale, version, compact = false } = Astro.props;
const t = useTranslations(locale);
const groups = getVersion(version).topology.map((g) => ({
  name: pick(g.group, locale),
  columns: g.columns.map((c) => c.map((id) => getProcess(version, id, locale).data)),
}));
---

<div class:list={['topology', { compact }]}>
  {
    groups.map((g) => (
      <section class="group grid-paper">
        <h2 class="group-label">{g.name}</h2>
        <div class="columns" style={compact ? `--cols: ${g.columns.length}` : undefined}>
          {g.columns.map((col) => (
            <ol class="column">
              {col.map((p) =>
                compact ? (
                  <li data-id={p.id}>
                    <a class="node" href={`#process-${p.id}`}>
                      <span class={`node-tab origin-${p.origin}`}>
                        <span>{p.id}</span>
                        <span data-part="activityCount">
                          {p.activities.length} {t('map.activities')}
                        </span>
                      </span>
                      <span class="node-name">{p.name}</span>
                    </a>
                  </li>
                ) : (
                  <li data-id={p.id}>
                    <a
                      class="node"
                      href={href(locale, version, 'processes', p.id)}
                      data-process={p.id}
                      data-version={version}
                      data-name={p.name}
                    >
                      <span class={`node-tab origin-${p.origin}`}>
                        <span>{p.id}</span>
                        <span>
                          {p.activities.length} {t('map.activities')}
                        </span>
                      </span>
                      <span class="node-name">{p.name}</span>
                      <span class="node-hit" hidden />
                    </a>
                  </li>
                ),
              )}
            </ol>
          ))}
        </div>
      </section>
    ))
  }
</div>

<style>
  .group {
    border: 1px solid var(--ink);
    padding: 44px 24px 24px;
    margin-top: 8px;
    position: relative;
  }

  /* The group name sits in a tab on the frame, like a drawing label. */
  .group-label {
    position: absolute;
    top: -1px;
    left: -1px;
    margin: 0;
    padding: 4px 12px;
    background: var(--ink-fill);
    color: var(--surface);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .group-label::after {
    display: none;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 14px 28px;
    align-items: start;
  }

  .column {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .node {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--ink);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.1s ease,
      box-shadow 0.1s ease,
      opacity 0.15s ease;
  }

  .node:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--lift);
  }

  .node-tab {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 2px 8px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .node-tab span:last-child {
    opacity: 0.8;
  }

  .node-name {
    padding: 8px 10px 10px;
    font-weight: 600;
    line-height: 1.3;
    min-height: 3.2em;
  }

  .dim .node {
    opacity: 0.25;
  }

  /* Where the search matched, when it is not in the name. */
  .node-hit {
    padding: 6px 10px 8px;
    border-top: 1px dashed var(--border);
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .node-hit :global(.hit-label) {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text);
  }

  .node-hit :global(mark) {
    background: var(--warn-bg);
    color: inherit;
    box-shadow: 0 0 0 1px var(--warn-border);
  }

  @media (max-width: 600px) {
    .group {
      padding: 40px 12px 12px;
    }

    .node-name {
      min-height: 0;
    }
  }

  /* On paper: as many columns as the group has, smaller, and each group kept
     on one page. */
  .compact .group {
    padding: 34px 12px 12px;
    break-inside: avoid;
  }

  .compact .columns {
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 8px 12px;
  }

  .compact .column {
    gap: 8px;
  }

  .compact .node {
    transition: none;
  }

  .compact .node:hover {
    transform: none;
    box-shadow: none;
  }

  .compact .node-tab {
    font-size: 0.66rem;
  }

  .compact .node-name {
    padding: 4px 6px 6px;
    font-size: 0.78rem;
    min-height: 0;
  }

  /* The printable PRM previewed on a small screen: one column, as there is no
     room for the paper's. Only on screen; the printed pages keep their columns. */
  @media screen and (max-width: 600px) {
    .compact .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
