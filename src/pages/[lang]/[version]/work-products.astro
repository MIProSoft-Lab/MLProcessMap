---
import Layout from '../../../layouts/Layout.astro';
import ProcessModal from '../../../components/ProcessModal.astro';
import LegendHelp from '../../../components/LegendHelp.astro';
import ProcessChip from '../../../components/ProcessChip.astro';
import SearchToolbar from '../../../components/SearchToolbar.astro';
import { getProcess, getWorkProducts } from '../../../lib/content';
import { versionLinks, versionPaths } from '../../../lib/paths';
import { searchKey } from '../../../lib/text';
import { pageLocale } from '../../../i18n/ui';

export const getStaticPaths = versionPaths;
const { locale, t } = pageLocale(Astro.props);
const { version } = Astro.params as { version: string };
const wps = getWorkProducts(version, locale);
const name = (pid: string) => getProcess(version, pid, locale).data.name;
const links = versionLinks(locale, ['work-products']);
const types = ['information-item', 'artifact', 'record'] as const;
---

<Layout locale={locale} title={t('wp.title')} description={t('wp.intro')} section="workProducts" version={version} versionLinks={links}>
  <h1>{t('wp.title')}</h1>

  <SearchToolbar class="no-print" placeholder={t('wp.filter')}>
    <div class="pills" role="group" aria-label={t('wp.type')}>
      <button type="button" data-type="" aria-pressed="true">{t('wp.all')}</button>
      {
        types.map((ty) => (
          <button type="button" data-type={ty} aria-pressed="false">
            {t(`wp.type-${ty}`)}
          </button>
        ))
      }
    </div>
  </SearchToolbar>
  <LegendHelp
    summary={t('wp.typesHelp')}
    items={types.map((ty) => ({ term: t(`wp.type-${ty}`), description: t(`wp.def-${ty}`) }))}
    badges
  />

  <div class="table-wrap">
    <table class="wp-table">
      <thead>
        <tr>
          <th>{t('wp.title')}</th>
          <th>{t('wp.type')}</th>
          <th>{t('wp.producers')}</th>
          <th>{t('wp.consumers')}</th>
        </tr>
      </thead>
      <tbody>
        {
          wps.map((w) => (
            <tr
              id={w.id}
              data-type={w.type}
              data-search={searchKey([w.name, ...[...w.producers, ...w.consumers].map((l) => `${l.process} ${name(l.process)}`)].join(' '))}
            >
              <td>
                <strong>{w.name}</strong>
              </td>
              <td>
                <span class="badge" title={t(`wp.def-${w.type}`)}>
                  {t(`wp.type-${w.type}`)}
                </span>
              </td>
              <td data-label={t('wp.producers')}>
                {w.producers.length ? (
                  <span class="chips">
                    {w.producers.map((l) => (
                      <ProcessChip locale={locale} version={version} id={l.process} name={name(l.process)} hash={`output-${w.id}`} />
                    ))}
                  </span>
                ) : (
                  <span class="muted small">{t('process.external')}</span>
                )}
              </td>
              <td data-label={t('wp.consumers')}>
                {w.consumers.length ? (
                  <span class="chips">
                    {w.consumers.map((l) => (
                      <ProcessChip locale={locale} version={version} id={l.process} name={name(l.process)} hash={`input-${w.id}`} />
                    ))}
                  </span>
                ) : (
                  <span class="muted small">{t('process.notUsed')}</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p id="empty" class="muted" hidden>{t('wp.noResults')}</p>
  <ProcessModal locale={locale} openLinksIn="main" />
</Layout>

<script>
  import { bindSearch, highlightTarget, queryWords } from '../../../lib/search';

  const input = document.querySelector<HTMLInputElement>('#q')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-type]:is(button)')];
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('tbody tr')];
  const table = document.querySelector<HTMLElement>('.table-wrap')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;
  let type = '';
  const apply = () => {
    const words = queryWords(input.value);
    let shown = 0;
    for (const r of rows) {
      r.hidden = (type !== '' && r.dataset.type !== type) || !words.every((w) => r.dataset.search!.includes(w));
      if (!r.hidden) shown++;
    }
    table.hidden = shown === 0;
    empty.hidden = shown > 0;
  };
  bindSearch(input, apply);
  for (const b of buttons) {
    b.addEventListener('click', () => {
      type = b.dataset.type!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    });
  }
  highlightTarget();
</script>

<style>
  .toolbar {
    gap: 12px;
    margin: 16px 0;
  }

  /* As tall as the search field next to it. */
  .toolbar .pills {
    align-self: stretch;
  }

  .wp-table td:first-child {
    min-width: 180px;
  }

  .wp-table tr {
    scroll-margin-top: 16px;
  }

  .wp-table tr:target,
  .wp-table tr.highlight {
    background: var(--surface-2);
  }

  .wp-table :global(.chip) {
    font-size: 0.8rem;
  }

  /* On a narrow screen each work product is a card: name and type, then who
     produces it and who uses it, each under its own label. */
  @media (max-width: 700px) {
    /* The processes by their ID alone, to keep each card short. The name is
       still read out by screen readers, and the process opens on a tap. */
    .wp-table :global(.chip .link-name) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .wp-table,
    .wp-table tbody,
    .wp-table td {
      display: block;
    }

    .wp-table thead {
      display: none;
    }

    /* Who produces it and who uses it side by side, under the name and type. */
    .wp-table tr:not([hidden]) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 16px;
      padding: 10px 12px 12px;
      border-bottom: 1px solid var(--ink);
    }

    .wp-table tr:last-child {
      border-bottom: 0;
    }

    .wp-table td {
      padding: 0;
      border: 0;
    }

    .wp-table td:first-child {
      min-width: 0;
      font-size: 1rem;
    }

    .wp-table td + td {
      margin-top: 6px;
    }

    .wp-table td:not([data-label]) {
      grid-column: 1 / -1;
    }

    .wp-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      margin: 4px 0;
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
  }
</style>
