---
// A process of a PRM version, laid out like a drawing sheet: a title block,
// then numbered sections (src/components/process/), each but the purpose
// opening and closing on its own (src/lib/process-page.ts).
import Layout from '../../../../layouts/Layout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ProcessSection from '../../../../components/process/ProcessSection.astro';
import TitleBlock from '../../../../components/process/TitleBlock.astro';
import Outcomes from '../../../../components/process/Outcomes.astro';
import Interface from '../../../../components/process/Interface.astro';
import Activities from '../../../../components/process/Activities.astro';
import Changes from '../../../../components/process/Changes.astro';
import Pager from '../../../../components/process/Pager.astro';
import '../../../../styles/process.css';
import { getProcess, getVersion, processIds, versions } from '../../../../lib/content';
import { processPaths, versionLinks } from '../../../../lib/paths';
import { plain } from '../../../../lib/text';
import { prose } from '../../../../lib/acronyms';
import { printHref } from '../../../../lib/print-options';
import { pageLocale, href } from '../../../../i18n/ui';

export const getStaticPaths = processPaths;
const { locale, t } = pageLocale(Astro.props);
const { version, id } = Astro.params as { version: string; id: string };
const { data: p, translated } = getProcess(version, id, locale);

// Changelog: what changed from the previous version.
const changelog = p.changes ?? [];
const previousVersion = versions[versions.findIndex((x) => x.id === version) - 1]?.id;

const ids = processIds(version);
const i = ids.indexOf(id);

const links = versionLinks(locale, ['processes', id], (v) => processIds(v).includes(id));
// Compare this version with the previous one, or with the next from the first.
const order = versions.map((x) => x.id);
const at = order.indexOf(version);
const compareHref =
  order.length > 1 ? href(locale, 'compare', at > 0 ? `${order[at - 1]}-vs-${version}` : `${version}-vs-${order[at + 1]}`, id) : undefined;

// Numbered sections, as on a drawing sheet.
const sections = [
  ['purpose', t('process.purpose')],
  ['outcomes', t('process.outcomes')],
  ['interface', `${t('process.inputs')} · ${t('process.outputs')}`],
  ['activities', t('process.activities')],
  ...(changelog.length ? [['changes', t('process.changes')]] : []),
] as [string, string][];
const num = (key: string) => String(sections.findIndex(([k]) => k === key) + 1).padStart(2, '0');
const title = (key: string) => sections.find(([k]) => k === key)![1];
---

<Layout
  locale={locale}
  title={p.name}
  description={plain(p.purpose)}
  section="processes"
  version={version}
  versionLinks={links}
  translated={translated}
  pageClass="process-page"
>
  {
    /* The breadcrumbs and the buttons share the first line, so the name has the
      whole of the next, however long it is (process.css). */
  }
  <div class="title-row">
    <Breadcrumbs locale={locale} items={[{ text: `ML-PRM / ${version}`, href: href(locale, version) }, { text: p.id }]} />
    <h1>{p.name}</h1>
    <span class="title-actions no-print">
      {
        compareHref && (
          <a class="button" href={compareHref}>
            ⇄ {t('compare.title')}
          </a>
        )
      }
      <a class="button" href={printHref(href(locale, version, 'print'), id)}>⎙ {t('print.button')}</a>
    </span>
  </div>

  <TitleBlock locale={locale} process={p} version={getVersion(version)} index={i} total={ids.length} />
  <Pager locale={locale} version={version} prev={ids[i - 1]} next={ids[i + 1]} />

  <div class="layout">
    <aside class="toc no-print" aria-label={t('process.contents')}>
      <ol>
        {
          sections.map(([key, label]) => (
            <li>
              <a href={`#${key}`}>
                <span class="mono">{num(key)}</span> {label}
              </a>
            </li>
          ))
        }
      </ol>
    </aside>

    <article class="content">
      <ProcessSection locale={locale} id="purpose" num={num('purpose')} title={title('purpose')} collapsible={false}>
        <p class="prose purpose" set:html={prose(p.purpose, locale)} />
      </ProcessSection>

      <ProcessSection locale={locale} id="outcomes" num={num('outcomes')} title={title('outcomes')}>
        <Outcomes locale={locale} process={p} />
      </ProcessSection>

      <ProcessSection locale={locale} id="interface" num={num('interface')} title={title('interface')}>
        <Interface locale={locale} version={version} process={p} />
      </ProcessSection>

      <ProcessSection locale={locale} id="activities" num={num('activities')} title={title('activities')}>
        <button
          slot="tools"
          type="button"
          class="toggle-all no-print"
          data-expand={t('process.expandAll')}
          data-collapse={t('process.collapseAll')}
        >
          {t('process.collapseAll')}
        </button>
        <Activities locale={locale} process={p} />
      </ProcessSection>

      {
        changelog.length > 0 && (
          <ProcessSection locale={locale} id="changes" num={num('changes')} title={title('changes')}>
            <Changes locale={locale} changes={changelog} previousVersion={previousVersion} />
          </ProcessSection>
        )
      }
    </article>
  </div>
</Layout>

<script>
  import { initProcessPage } from '../../../../lib/process-page';

  initProcessPage();
</script>
