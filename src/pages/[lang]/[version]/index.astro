---
import Layout from '../../../layouts/Layout.astro';
import ProcessModal from '../../../components/ProcessModal.astro';
import { getVersion, getProcess, pick, versions } from '../../../lib/content';
import { versionPaths } from '../../../lib/paths';
import { plain } from '../../../lib/text';
import { useTranslations, href, type Locale } from '../../../i18n/ui';

export const getStaticPaths = versionPaths;
const locale = Astro.props.locale as Locale;
const { version } = Astro.params as { version: string };
const t = useTranslations(locale);
const v = getVersion(version);

// What the search looks through in each process: its name, then every other
// part with the label shown next to a match found there.
const tile = (id: string) => {
  const { data: p, translated } = getProcess(version, id, locale);
  const fields = [
    ['', p.name],
    [t('process.purpose'), p.purpose],
    ...p.outcomes.map((o) => [t('map.inOutcome', { id: o.id }), o.text]),
    ...p.activities.map((a) => [a.id, `${a.title}. ${a.description}`]),
  ].map(([label, text]) => [label, plain(text)]);
  return { p, translated, fields };
};
const groups = v.topology.map((g) => ({ name: pick(g.group, locale), columns: g.columns.map((c) => c.map(tile)) }));
const translated = groups.every((g) => g.columns.every((c) => c.every((x) => x.translated)));
const versionLinks = Object.fromEntries(versions.map((x) => [x.id, href(locale, x.id)]));
const origins = ['standards-and-literature', 'standards-only', 'decomposed'] as const;
const searchData = Object.fromEntries(groups.flatMap((g) => g.columns.flat()).map((x) => [x.p.id, x.fields]));
---

<Layout locale={locale} title={`${t('map.title')} ${version}`} description={`${t('home.card-map')} ${pick(v.description, locale)}`} section="processes" version={version} versionLinks={versionLinks} translated={translated}>
  <p class="breadcrumbs">ML-PRM / {version}</p>
  <h1>{t('map.title')} <span class="muted">· {pick(v.title, locale)}</span></h1>
  <p class="muted prose">{pick(v.description, locale)}</p>

  <div class="toolbar">
    <label class="visually-hidden" for="q">{t('map.search')}</label>
    <input id="q" type="search" placeholder={t('map.search')} autocomplete="off" />
    <span id="count" class="small muted" role="status" data-text={t('map.matches')}></span>
    <div class="legend" aria-label={t('map.legend')}>
      {
        origins.map((o) => (
          <span title={t(`origin.${o}-long`)}>
            <span class={`swatch origin-${o}`} />
            {t(`origin.${o}`)}
          </span>
        ))
      }
    </div>
  </div>
  <details class="legend-help small">
    <summary class="muted">{t('map.legendHelp')}</summary>
    <dl>
      {
        origins.map((o) => (
          <div>
            <dt>
              <span class={`swatch origin-${o}`} />
              {t(`origin.${o}`)}
            </dt>
            <dd class="muted">{t(`origin.${o}-long`)}</dd>
          </div>
        ))
      }
    </dl>
  </details>

  {
    groups.map((g) => (
      <section class="group grid-paper">
        <h2 class="group-label">{g.name}</h2>
        <div class="columns">
          {g.columns.map((col) => (
            <ol class="column">
              {col.map(({ p }) => (
                <li data-id={p.id}>
                  <a class="node" href={href(locale, version, 'processes', p.id)} data-process={p.id} data-version={version} data-name={p.name}>
                    <span class={`node-tab origin-${p.origin}`}>
                      <span>{p.id}</span>
                      <span>
                        {p.activities.length} {t('map.activities')}
                      </span>
                    </span>
                    <span class="node-name">{p.name}</span>
                    <span class="node-hit" hidden />
                  </a>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </section>
    ))
  }
  <p id="empty" class="muted" hidden>{t('map.noResults')}</p>
  <ProcessModal locale={locale} />
  <script type="application/json" id="map-search" set:html={JSON.stringify(searchData).replace(/</g, '\\u003c')} />
</Layout>

<script>
  import { createProcessModal, openLinksInModal } from '../../../lib/process-modal';
  import { escapeHtml, format, searchKey } from '../../../lib/text';

  openLinksInModal(document.getElementById('main')!, createProcessModal());

  // Search: dim the processes that do not match, say how many do, and show
  // where the match is when it is not in the name. The query is kept in the
  // address, so it is still there on coming back to the map.
  type Field = { label: string; text: string; key: string };
  const data = JSON.parse(document.getElementById('map-search')!.textContent!) as Record<string, [string, string][]>;
  const index = new Map<string, Field[]>(Object.entries(data).map(([id, fields]) => [id, fields.map(([label, text]) => ({ label, text, key: searchKey(text) }))]));

  const input = document.querySelector<HTMLInputElement>('#q')!;
  const items = [...document.querySelectorAll<HTMLElement>('li[data-id]')];
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const count = document.querySelector<HTMLElement>('#count')!;

  /** The text around the first word found in a field, with the words found marked. */
  function excerpt(f: Field, words: string[]) {
    // The key is the text without accents; they line up unless a letter changes length.
    const aligned = f.key.length === f.text.length;
    const first = Math.min(...words.map((w) => f.key.indexOf(w)).filter((i) => i >= 0));
    let start = aligned ? Math.max(0, first - 30) : 0;
    if (start > 0) {
      const space = f.text.indexOf(' ', start);
      if (space >= 0 && space < first) start = space + 1;
    }
    const end = Math.min(f.text.length, start + 90);
    const text = f.text.slice(start, end);
    const marks = new Array<boolean>(text.length).fill(false);
    if (aligned) {
      const key = f.key.slice(start, end);
      for (const w of words) for (let i = key.indexOf(w); i >= 0; i = key.indexOf(w, i + 1)) marks.fill(true, i, i + w.length);
    }
    let html = '';
    for (let i = 0; i < text.length; ) {
      let j = i;
      while (j < text.length && marks[j] === marks[i]) j++;
      const part = escapeHtml(text.slice(i, j));
      html += marks[i] ? `<mark>${part}</mark>` : part;
      i = j;
    }
    return `<span class="hit-label">${escapeHtml(f.label)}</span> ${start > 0 ? '…' : ''}${html}${end < f.text.length ? '…' : ''}`;
  }

  const apply = () => {
    const words = searchKey(input.value).split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of items) {
      const [name, ...rest] = index.get(el.dataset.id!)!;
      const match = words.every((w) => name.key.includes(w) || rest.some((f) => f.key.includes(w)));
      el.classList.toggle('dim', !match);
      if (match) shown++;
      const hit = el.querySelector<HTMLElement>('.node-hit')!;
      // The part with most of the words, unless the name has them all.
      const where =
        match && words.length && !words.every((w) => name.key.includes(w))
          ? rest.map((f) => ({ f, n: words.filter((w) => f.key.includes(w)).length })).reduce((a, b) => (b.n > a.n ? b : a))
          : null;
      hit.hidden = !where?.n;
      hit.innerHTML = where?.n ? excerpt(where.f, words) : '';
    }
    count.textContent = words.length ? format(count.dataset.text!, { n: shown, total: items.length }) : '';
    empty.hidden = shown > 0;
    const url = new URL(location.href);
    input.value.trim() ? url.searchParams.set('q', input.value) : url.searchParams.delete('q');
    history.replaceState(history.state, '', url);
  };
  input.value = new URLSearchParams(location.search).get('q') ?? '';
  input.addEventListener('input', apply);
  apply();
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    margin: 20px 0 16px;
  }

  .toolbar input {
    flex: 1 1 280px;
    max-width: 460px;
  }

  .group {
    border: 1px solid var(--ink);
    padding: 44px 24px 24px;
    margin-top: 8px;
    position: relative;
  }

  /* The group name sits in a tab on the frame, like a drawing label. */
  .group-label {
    position: absolute;
    top: -1px;
    left: -1px;
    margin: 0;
    padding: 4px 12px;
    background: var(--ink-fill);
    color: var(--surface);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .group-label::after {
    display: none;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 14px 28px;
    align-items: start;
  }

  .column {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .node {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--ink);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.1s ease,
      box-shadow 0.1s ease,
      opacity 0.15s ease;
  }

  .node:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--lift);
  }

  .node-tab {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 2px 8px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .node-tab span:last-child {
    opacity: 0.8;
  }

  .node-name {
    padding: 8px 10px 10px;
    font-weight: 600;
    line-height: 1.3;
    min-height: 3.2em;
  }

  .dim .node {
    opacity: 0.25;
  }

  /* Where the search matched, when it is not in the name. */
  .node-hit {
    padding: 6px 10px 8px;
    border-top: 1px dashed var(--border);
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .node-hit :global(.hit-label) {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text);
  }

  .node-hit :global(mark) {
    background: var(--warn-bg);
    color: inherit;
    box-shadow: 0 0 0 1px var(--warn-border);
  }

  .legend-help {
    margin: -6px 0 16px;
  }

  .legend-help summary {
    cursor: pointer;
    width: fit-content;
  }

  .legend-help dl {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    max-width: 720px;
  }

  .legend-help dt {
    font-weight: 600;
  }

  .legend-help dd {
    margin: 0 0 0 24px;
  }

  .legend-help .swatch {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-right: 10px;
    vertical-align: -2px;
    border: 1px solid var(--ink);
  }

  @media (max-width: 600px) {
    .group {
      padding: 40px 12px 12px;
    }

    .node-name {
      min-height: 0;
    }
  }
</style>
