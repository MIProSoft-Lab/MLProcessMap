---
import Layout from '../../layouts/Layout.astro';
import ProcessModal from '../../components/ProcessModal.astro';
import LifecycleDiagram from '../../components/LifecycleDiagram.astro';
import '../../styles/tailor.css';
import { versions, defaultVersion, getProcesses, getWorkProducts, lifecycleIds, getLifecycle, pick } from '../../lib/content';
import { localePaths } from '../../lib/paths';
import { plain } from '../../lib/text';
import { diagramKeys } from '../../lib/lifecycle-diagram';
import { exportKeys } from '../../lib/tailor/export';
import { useTranslations, href, type Locale, type UiKey } from '../../i18n/ui';

export const getStaticPaths = localePaths;
const locale = Astro.props.locale as Locale;
const t = useTranslations(locale);

// Everything the client needs, for every version.
const data = {
  defaultVersion,
  base: href(locale),
  versions: versions.map((v) => ({
    id: v.id,
    title: pick(v.title, locale),
    processes: getProcesses(v.id, locale).map(({ data: p }) => ({
      id: p.id,
      name: p.name,
      origin: p.origin,
      purpose: plain(p.purpose),
      activities: p.activities.map((a) => ({ id: a.id, title: plain(a.title) })),
      inputs: p.inputs.map((i) => i.workProduct),
    })),
    workProducts: Object.fromEntries(
      getWorkProducts(v.id, locale).map((w) => [
        w.id,
        { name: w.name, external: w.external, producers: w.producers.map((p) => p.process) },
      ]),
    ),
  })),
  lifecycles: lifecycleIds().map((id) => {
    const l = getLifecycle(id, locale).data;
    return {
      id,
      name: l.name,
      version: l.prmVersion,
      description: plain(l.description),
      processes: l.phases.flatMap((p) => p.processes),
      phases: l.phases.map((ph) => ({ ...ph, description: ph.description ? plain(ph.description) : '' })),
    };
  }),
};

// The strings of the page's script; the drawing and the exports list their own.
const keys: UiKey[] = [
  ...diagramKeys,
  ...exportKeys,
  'tailor.selected',
  'tailor.allCovered',
  'tailor.copied',
  'tailor.copyLink',
  'tailor.rationale',
  'tailor.start-all',
  'tailor.start-none',
  'tailor.start-note',
  'process.activities',
  'process.producedBy',
  'nav.lifecycles',
  'modal.details',
  'tailor.phase-name',
  'tailor.phase-up',
  'tailor.phase-down',
  'tailor.phase-remove',
  'tailor.phase-description',
  'tailor.phase-noReturn',
  'tailor.phase-returnNote',
  'tailor.phase-drop',
  'tailor.phase-drop-touch',
  'tailor.bar-selected',
  'tailor.bar-missing',
  'tailor.undo-replaced',
  'tailor.undo-all',
  'tailor.undo-none',
  'tailor.undo-phase',
  'tailor.undo-version',
  'tailor.phase-addProcess',
  'tailor.phase-unassign',
  'tailor.phase-none',
  'tailor.phase-of',
  'tailor.unassigned-none',
  'tailor.phases-summary',
  'tailor.import-done',
  'tailor.import-csv',
  'tailor.import-skipped',
  'tailor.import-version',
  'tailor.import-error',
];
const strings = Object.fromEntries(keys.map((k) => [k, t(k)]));
---

<Layout locale={locale} title={t('tailor.title')} description={t('tailor.intro')} section="tailor" pageClass="tailor-page">
  <h1>{t('tailor.title')}</h1>
  <p class="muted prose">{t('tailor.intro')}</p>
  <noscript><p class="notice">{t('tailor.noscript')}</p></noscript>
  <p id="restore" class="notice restore no-print" role="status" hidden>
    <span>{t('tailor.restore-text')} <strong id="restore-name"></strong></span>
    <button type="button" id="restore-yes">{t('tailor.restore-yes')}</button>
    <button type="button" id="restore-no">{t('tailor.restore-no')}</button>
  </p>

  <div class="controls card no-print">
    <label>
      <span>{t('tailor.project')}</span>
      <input type="text" id="project" />
    </label>
    <label>
      <span>{t('tailor.version')}</span>
      <select id="version">
        {
          versions.map((v) => (
            <option value={v.id}>
              {v.id} · {pick(v.title, locale)}
            </option>
          ))
        }
      </select>
    </label>
    <details class="menu start-menu" id="start">
      <summary>{t('tailor.start')}…</summary>
      <ul id="start-list"></ul>
    </details>
  </div>

  <div class="layout">
    <section class="no-print">
      <div class="tabs" role="tablist">
        <button type="button" role="tab" id="tab-processes" data-tab="processes" aria-controls="panel-processes" aria-selected="true">
          {t('tailor.tab-processes')}
        </button>
        <button type="button" role="tab" id="tab-phases" data-tab="phases" aria-controls="panel-phases" aria-selected="false" tabindex="-1">
          {t('tailor.tab-phases')}
          <span id="phase-count" class="count"></span>
        </button>
      </div>

      <div id="panel-processes" role="tabpanel" aria-labelledby="tab-processes">
        <div class="bulk">
          <button type="button" id="all">{t('tailor.selectAll')}</button>
          <button type="button" id="none">{t('tailor.selectNone')}</button>
        </div>
        <ol id="processes" class="processes"></ol>
        <p class="next-step"><button type="button" id="next-phases" class="primary button">{t('tailor.next-phases')} →</button></p>
      </div>

      <div id="panel-phases" role="tabpanel" aria-labelledby="tab-phases" hidden>
        <p class="small muted prose">{t('tailor.phases-intro')}</p>
        <label class="lc-description">
          <span class="small muted">{t('tailor.lcDescription')}</span>
          <textarea id="lc-description" rows="2"></textarea>
        </label>
        <ol id="phases" class="phase-list"></ol>
        <p><button type="button" id="add-phase">+ {t('tailor.phase-add')}</button></p>
        <section class="unassigned">
          <h2 class="label">{t('tailor.unassigned')}</h2>
          <ul id="unassigned" class="pc-procs dropzone" data-drop=""></ul>
        </section>
      </div>
    </section>

    <aside class="side no-print" id="side">
      <div class="card sticky">
        <p id="summary" class="summary"></p>
        <p id="phase-summary" class="small muted" hidden></p>
        <h2>
          <span>{t('tailor.missingInputs')} <span id="missing-count" class="count"></span></span>
        </h2>
        <p id="missing-note" class="small muted" hidden>{t('tailor.missingInputsNote')}</p>
        <ul id="missing" class="missing small"></ul>
        <h2>{t('tailor.share')}</h2>
        <p class="small muted">{t('tailor.shareNote')}</p>
        <div class="exports">
          <button type="button" id="copy" class="primary button">{t('tailor.copyLink')}</button>
        </div>
        <h2>{t('tailor.export')}</h2>
        <!-- Documents are for reading; data files can be imported again below. -->
        <h3 class="export-group" id="export-documents">{t('tailor.exportDocuments')}</h3>
        <div class="exports" role="group" aria-labelledby="export-documents">
          <button type="button" data-export="md">{t('tailor.markdown')}</button>
          <button type="button" id="print">{t('tailor.print')}</button>
        </div>
        <h3 class="export-group" id="export-data">{t('tailor.exportData')}</h3>
        <p class="small muted">{t('tailor.exportDataNote')}</p>
        <div class="exports" role="group" aria-labelledby="export-data">
          <button type="button" data-export="json">{t('tailor.json')}</button>
          <button type="button" data-export="yaml" id="export-yaml" aria-describedby="yaml-note">{t('tailor.yaml')}</button>
          <button type="button" data-export="csv">{t('tailor.csv')}</button>
        </div>
        <p id="yaml-note" class="small muted">{t('tailor.yamlNote')}</p>
        <h2>{t('tailor.import')}</h2>
        <p class="small muted">{t('tailor.import-note')}</p>
        <div class="exports">
          <button type="button" id="import">{t('tailor.import-open')}</button>
          <input type="file" id="import-file" accept=".json,.yaml,.yml,.csv,application/json,application/yaml,text/csv" hidden />
        </div>
        <p id="import-status" class="small" role="status" hidden></p>
      </div>
    </aside>
  </div>

  <section id="preview-section" class="no-print" hidden>
    <h2 class="preview-title">{t('tailor.preview')}</h2>
    <p id="preview-empty" class="muted small">{t('tailor.preview-empty')}</p>
    <div id="preview">
      <LifecycleDiagram locale={locale} />
    </div>
  </section>

  <p id="undo" class="undo no-print" role="status" hidden>
    <span id="undo-text"></span>
    <button type="button" id="undo-yes">{t('tailor.undo')}</button>
    <button type="button" id="undo-close" aria-label={t('modal.close')}>✕</button>
  </p>

  <a id="mobile-bar" class="mobile-bar no-print" href="#side">
    <span id="mobile-summary"></span>
    <span class="mobile-bar-go">{t('tailor.export')} ↓</span>
  </a>

  <div id="print-view" class="print-only"></div>

  <ProcessModal locale={locale} />

  <script type="application/json" id="tailor-data" set:html={JSON.stringify({ data, strings })} />
</Layout>

<script>
  import { createProcessModal, openLinksInModal } from '../../lib/process-modal';
  import { diagramSvgs } from '../../lib/lifecycle-diagram';
  import { translator } from '../../lib/client-strings';
  import { escapeHtml as esc } from '../../lib/text';
  import * as model from '../../lib/tailor/model';
  import type { Data, Phase, Proc, State } from '../../lib/tailor/model';
  import * as exporter from '../../lib/tailor/export';
  import { ImportError, readModel } from '../../lib/tailor/import';

  const { data, strings } = JSON.parse(document.getElementById('tailor-data')!.textContent!) as {
    data: Data;
    strings: Record<string, string>;
  };
  const s = translator(strings);
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const { phase, phasesOf, slug } = model;

  // --- State, kept in the URL hash so a selection can be shared ---------

  const version = (id: string) => model.versionOf(data, id);

  // The last model edited is also kept in the browser, to offer it again on a
  // visit that starts without one. Opening a model does not replace it; editing does.
  const STORE = 'prm-tool:tailor:last';
  const stored = {
    get() {
      try {
        return localStorage.getItem(STORE);
      } catch {
        return null; // Storage can be blocked, and the builder works without it.
      }
    },
    set(hash: string | null) {
      try {
        hash === null ? localStorage.removeItem(STORE) : localStorage.setItem(STORE, hash);
      } catch {}
    },
  };
  const last = location.hash.length > 1 ? null : stored.get();

  let state = model.fromHash(data, location.hash.slice(1));

  const syncPhases = () => model.syncPhases(state, version(state.version));
  syncPhases();

  /** The model without the open tab, which is not part of it. */
  const modelKey = (x: State) => model.toHash({ ...x, tab: 'processes' });
  const opened = modelKey(state);
  let edited = false;
  const restore = $('#restore');

  const toHash = () => {
    const hash = model.toHash(state);
    history.replaceState(null, '', `#${hash}`);
    if (undo && modelKey(state) !== undo.after) dismissUndo();
    edited ||= modelKey(state) !== opened;
    if (!edited) return;
    stored.set(hash);
    restore.hidden = true;
  };

  // --- Undo ------------------------------------------------------------

  // An action that replaces work (a template, select all or none, a removed
  // phase, another PRM version, an imported file) can be taken back until the
  // next edit, which would otherwise be lost with it.
  let undo: { before: string; after: string } | null = null;
  const undoBar = $('#undo');
  const snapshot = () => model.toHash(state);

  function dismissUndo() {
    undo = null;
    undoBar.hidden = true;
  }

  /** Offer to return to the model as it was before an action, given what `snapshot()` returned then. */
  function offerUndo(before: string, message: string) {
    if (before === snapshot()) return;
    undo = { before, after: modelKey(state) };
    $('#undo-text').textContent = message;
    undoBar.hidden = false;
  }

  $('#undo-yes').addEventListener('click', () => {
    if (!undo) return;
    const back = model.fromHash(data, undo.before);
    dismissUndo();
    load(back);
    document.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]')?.focus();
  });
  $('#undo-close').addEventListener('click', dismissUndo);

  // --- Rendering ---------------------------------------------------------

  const list = $('#processes');
  const phaseList = $('#phases');
  const unassignedList = $('#unassigned');
  const figure = $('#preview .lc-diagram');
  const viewport = figure.querySelector<HTMLElement>('.viewport')!;

  const procOf = (id: string) => version(state.version).processes.find((p) => p.id === id);
  const phaseOf = (id: string) => model.phaseOf(state, id);
  const unassigned = () => model.unassigned(state, version(state.version));
  // A touch screen cannot drag the process chips, so an empty phase points at the menu below it.
  const touch = matchMedia('(pointer: coarse)').matches;
  const phaseLabel = (p: Phase, i: number) => `${String(i + 1).padStart(2, '0')} ${p.name || s('tailor.phase-new', { n: i + 1 })}`;

  function phaseSelect(id: string) {
    if (!state.phases.length || !state.selected.has(id)) return '';
    const current = phaseOf(id)?.id ?? '';
    const options = [`<option value="">${esc(s('tailor.phase-none'))}</option>`]
      .concat(
        state.phases.map((p, i) => `<option value="${esc(p.id)}" ${p.id === current ? 'selected' : ''}>${esc(phaseLabel(p, i))}</option>`),
      )
      .join('');
    return `<select class="phase-select" data-phase-of="${id}" aria-label="${esc(s('tailor.phase-of', { id }))}">${options}</select>`;
  }

  /**
   * Redrawing replaces every row, which would close the open lists and drop the
   * keyboard focus. This notes both before a redraw and returns the way to put them back.
   */
  function rememberView() {
    const rows = 'li.proc, li.phase-card';
    const rowSel = (row: HTMLElement) =>
      row.dataset.phase !== undefined
        ? `#phases [data-phase="${CSS.escape(row.dataset.phase)}"]`
        : `#processes [data-id="${CSS.escape(row.dataset.id!)}"]`;
    const open = [...document.querySelectorAll<HTMLElement>('#processes details[open], #phases details[open]')].map((d) =>
      rowSel(d.closest<HTMLElement>(rows)!),
    );
    const active = document.activeElement;
    const row =
      active instanceof HTMLElement && (list.contains(active) || phaseList.contains(active)) ? active.closest<HTMLElement>(rows) : null;
    // The focused control is found again by its tag and data attributes, e.g. input[data-proc="P01"].
    const focused = row && {
      row: rowSel(row),
      el:
        active!.tagName.toLowerCase() +
        [...active!.attributes]
          .filter((a) => a.name.startsWith('data-'))
          .map((a) => `[${a.name}="${CSS.escape(a.value)}"]`)
          .join(''),
    };
    return () => {
      for (const sel of open) document.querySelector<HTMLDetailsElement>(`${sel} details`)?.setAttribute('open', '');
      if (!focused) return;
      // A control that is gone (a removed chip, a removed phase) hands the focus to its row, or to "Add phase".
      const again =
        document.querySelector<HTMLElement>(`${focused.row} ${focused.el}`) ??
        document.querySelector<HTMLElement>(`${focused.row} :is(input, select, button:not(:disabled))`) ??
        $('#add-phase');
      again.focus();
    };
  }

  function renderList() {
    const restoreView = rememberView();
    const v = version(state.version);
    list.innerHTML = v.processes
      .map((p) => {
        const on = state.selected.has(p.id);
        const acts = p.activities
          .map(
            (
              a,
            ) => `<li><label><input type="checkbox" data-act="${p.id}.${a.id}" ${state.excluded.has(`${p.id}.${a.id}`) ? '' : 'checked'} ${on ? '' : 'disabled'}>
              <span class="aid">${a.id}</span> ${esc(a.title)}</label></li>`,
          )
          .join('');
        return `<li class="proc ${on ? '' : 'off'}" data-id="${p.id}">
          <div class="proc-head" data-hover-process="${p.id}" data-hover-version="${state.version}">
            <label class="proc-label"><input type="checkbox" data-proc="${p.id}" ${on ? 'checked' : ''}>
              <span class="dot origin-${p.origin}"></span><span class="num">${p.id}</span> <strong>${esc(p.name)}</strong></label>
            <span class="proc-tools">${phaseSelect(p.id)}
              <button type="button" class="info" data-info="${p.id}" aria-label="${esc(s('modal.details', { name: p.name }))}">i</button></span>
          </div>
          <details><summary class="small muted">${s('process.activities')} (<span data-count="${p.id}"></span>)</summary><ul class="acts">${acts}</ul></details>
          <label class="rationale small" ${on ? 'hidden' : ''}><span>${s('tailor.rationale')}</span>
            <input type="text" data-why="${p.id}" value="${esc(state.rationale[p.id] ?? '')}"></label>
        </li>`;
      })
      .join('');
    renderPhases();
    restoreView();
  }

  const chip = (id: string, from: string) => {
    const p = procOf(id);
    if (!p) return '';
    return `<li class="pchip origin-${p.origin}" draggable="true" data-pid="${id}" data-from="${esc(from)}" data-hover-process="${id}" data-hover-version="${state.version}">
      <span class="num">${id}</span><span class="pchip-name">${esc(p.name)}</span>
      ${from ? `<button type="button" class="pchip-x" data-unassign="${id}" data-from="${esc(from)}" aria-label="${esc(s('tailor.phase-unassign', { id }))}">×</button>` : ''}
    </li>`;
  };

  function renderPhases() {
    const free = unassigned();
    phaseList.innerHTML = state.phases
      .map((p, i) => {
        const others = state.phases
          .map((o, k) =>
            o.id === p.id ? '' : `<option value="${esc(o.id)}" ${o.id === p.returnsTo ? 'selected' : ''}>${esc(phaseLabel(o, k))}</option>`,
          )
          .join('');
        // The menu adds a process without a phase, or moves one here from another
        // phase, which is the way to arrange them without dragging.
        const option = (id: string) => `<option value="${id}">${id} ${esc(procOf(id)?.name ?? '')}</option>`;
        const group = (label: string, ids: string[]) =>
          ids.length ? `<optgroup label="${esc(label)}">${ids.map(option).join('')}</optgroup>` : '';
        const choices =
          group(
            s('tailor.phase-none'),
            free.map((f) => f.id),
          ) + state.phases.map((o, k) => (o.id === p.id ? '' : group(phaseLabel(o, k), o.processes))).join('');
        const add = choices
          ? `<select class="pc-add" data-add-to="${esc(p.id)}"><option value="">${esc(s('tailor.phase-addProcess'))}</option>${choices}</select>`
          : '';
        return `<li class="phase-card" data-phase="${esc(p.id)}">
          <div class="pc-head">
            <span class="pc-step">${String(i + 1).padStart(2, '0')}</span>
            <input type="text" class="pc-name" data-field="name" value="${esc(p.name)}" placeholder="${esc(s('tailor.phase-new', { n: i + 1 }))}" aria-label="${esc(s('tailor.phase-name'))}">
            <span class="pc-tools">
              <button type="button" data-move="-1" ${i === 0 ? 'disabled' : ''} aria-label="${esc(s('tailor.phase-up'))}" title="${esc(s('tailor.phase-up'))}">↑</button>
              <button type="button" data-move="1" ${i === state.phases.length - 1 ? 'disabled' : ''} aria-label="${esc(s('tailor.phase-down'))}" title="${esc(s('tailor.phase-down'))}">↓</button>
              <button type="button" data-remove aria-label="${esc(s('tailor.phase-remove'))}" title="${esc(s('tailor.phase-remove'))}">✕</button>
            </span>
          </div>
          <ul class="pc-procs dropzone" data-drop="${esc(p.id)}">${p.processes.map((id) => chip(id, p.id)).join('') || `<li class="pc-empty small muted">${esc(touch && add ? s('tailor.phase-drop-touch') : s('tailor.phase-drop'))}</li>`}</ul>
          ${add}
          <div class="pc-options small">
            <label><input type="checkbox" data-field="iterative" ${p.iterative ? 'checked' : ''}> ↻ ${esc(s('lc.iterative'))}</label>
            <label>↩ ${esc(s('tailor.phase-returnsTo'))}
              <select data-field="returnsTo"><option value="">${esc(s('tailor.phase-noReturn'))}</option>${others}</select></label>
            <label class="pc-note" ${p.returnsTo ? '' : 'hidden'}>${esc(s('tailor.phase-returnNote'))}
              <input type="text" data-field="returnNote" value="${esc(p.returnNote)}"></label>
          </div>
          <details class="small" ${p.description ? 'open' : ''}><summary class="muted">${esc(s('tailor.phase-description'))}</summary>
            <textarea data-field="description" rows="2">${esc(p.description)}</textarea></details>
        </li>`;
      })
      .join('');
    unassignedList.innerHTML =
      free.map((p) => chip(p.id, '')).join('') || `<li class="pc-empty small muted">${esc(s('tailor.unassigned-none'))}</li>`;
    $('#phase-count').textContent = state.phases.length ? `(${state.phases.length})` : '';
    renderPreview();
    renderSummary();
  }

  function renderPreview() {
    const has = state.phases.length > 0;
    $('#preview').hidden = !has;
    $('#preview-empty').hidden = has;
    if (!has) return;
    const v = state.version;
    viewport.innerHTML = diagramSvgs(
      {
        name: state.project || s('tailor.untitled'),
        version: v,
        procHref: (id) => `${data.base}${v}/processes/${id}/`,
        phases: state.phases.map((p, i) => ({
          ...p,
          name: p.name || s('tailor.phase-new', { n: i + 1 }),
          procs: p.processes.map(procOf).filter((x): x is Proc => !!x),
        })),
      },
      s,
    );
    figure.dispatchEvent(new Event('lc-diagram:update'));
  }

  const activeActivities = (p: Proc) => model.activeActivities(state, p);
  const missingInputs = () => model.missingInputs(state, version(state.version));

  function renderSummary() {
    const v = version(state.version);
    const acts = v.processes.reduce((n, p) => n + activeActivities(p).length, 0);
    $('#summary').textContent = s('tailor.selected', { n: state.selected.size, total: v.processes.length, a: acts });
    const phaseSummary = $('#phase-summary');
    phaseSummary.hidden = !state.phases.length;
    phaseSummary.textContent = s('tailor.phases-summary', { n: state.phases.length, u: unassigned().length });
    $<HTMLButtonElement>('#export-yaml').disabled = !state.phases.length;
    for (const p of v.processes) {
      const el = list.querySelector(`[data-count="${p.id}"]`);
      if (el) el.textContent = `${activeActivities(p).length}/${p.activities.length}`;
    }
    const missing = missingInputs();
    $('#missing-count').textContent = missing.size ? `(${missing.size})` : '';
    $('#missing-note').hidden = !missing.size;
    $('#mobile-summary').textContent =
      s('tailor.bar-selected', { n: state.selected.size, total: v.processes.length }) +
      (missing.size ? ` · ${s('tailor.bar-missing', { m: missing.size })}` : '');
    $('#missing').innerHTML = missing.size
      ? [...missing]
          .map(([wid, users]) => {
            const wp = v.workProducts[wid];
            return `<li><strong>${esc(wp.name)}</strong> <span class="muted">→ ${[...users].join(', ')}</span><br>
              <span class="muted">${s('process.producedBy')}:</span> ${wp.producers
                .map((pid) => `<button type="button" class="link" data-add="${pid}">+ ${pid}</button>`)
                .join(' ')}</li>`;
          })
          .join('')
      : `<li class="muted">${s('tailor.allCovered')}</li>`;
    toHash();
  }

  function renderStartOptions() {
    const lcs = data.lifecycles.filter((l) => l.version === state.version);
    const item = (value: string, label: string) => `<li><button type="button" data-start="${esc(value)}">${esc(label)}</button></li>`;
    $('#start-list').innerHTML =
      item('all', s('tailor.start-all')) +
      item('none', s('tailor.start-none')) +
      (lcs.length ? `<li class="menu-group">${esc(s('nav.lifecycles'))}</li>${lcs.map((l) => item(`lc:${l.id}`, l.name)).join('')}` : '') +
      `<li class="menu-foot">${esc(s('tailor.start-note'))}</li>`;
  }

  function showTab(tab: State['tab'], focus = false) {
    state.tab = tab;
    document.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((b) => {
      const on = b.dataset.tab === tab;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      if (on && focus) b.focus();
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !on;
    });
    // The preview spans the page, below the editor and the sidebar.
    $('#preview-section').hidden = tab !== 'phases';
    toHash();
  }

  // --- Events: processes --------------------------------------------------

  list.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.proc) {
      el.checked ? state.selected.add(el.dataset.proc) : state.selected.delete(el.dataset.proc);
      syncPhases();
      renderList();
    } else if (el.dataset.act) {
      el.checked ? state.excluded.delete(el.dataset.act) : state.excluded.add(el.dataset.act);
      renderSummary();
    } else if (el.dataset.phaseOf) {
      const id = el.dataset.phaseOf;
      for (const p of state.phases) p.processes = p.processes.filter((x) => x !== id);
      const target = state.phases.find((p) => p.id === el.value);
      if (target) insertInOrder(target, id);
      renderList();
    }
  });

  list.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.why) {
      state.rationale[el.dataset.why] = el.value;
      toHash();
    }
  });

  $('#missing').addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).dataset.add;
    if (!id) return;
    state.selected.add(id);
    renderList();
    // The button that was pressed is gone: move on to the next one, or to the process just added.
    ($('#missing').querySelector<HTMLElement>('button') ?? list.querySelector<HTMLElement>(`[data-proc="${id}"]`))?.focus();
  });

  $<HTMLInputElement>('#project').addEventListener('input', (e) => {
    state.project = (e.target as HTMLInputElement).value;
    if (state.phases.length) renderPreview();
    toHash();
  });

  $<HTMLSelectElement>('#version').addEventListener('change', (e) => {
    const before = snapshot();
    const v = version((e.target as HTMLSelectElement).value);
    // Keep the processes that exist in both versions; activities may differ.
    const ids = new Set(v.processes.map((p) => p.id));
    state = { ...state, version: v.id, selected: new Set([...state.selected].filter((id) => ids.has(id))), excluded: new Set() };
    syncPhases();
    renderStartOptions();
    renderList();
    offerUndo(before, s('tailor.undo-version', { v: v.id }));
  });

  // The "Start from" menu: each item replaces the selection, and a template the phases too.
  const startMenu = $<HTMLDetailsElement>('#start');
  const closeStart = (focus = false) => {
    startMenu.open = false;
    if (focus) startMenu.querySelector('summary')!.focus();
  };
  document.addEventListener('click', (e) => {
    if (startMenu.open && !startMenu.contains(e.target as Node)) closeStart();
  });
  startMenu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && startMenu.open) closeStart(true);
  });

  $('#start-list').addEventListener('click', (e) => {
    const value = (e.target as HTMLElement).closest<HTMLElement>('[data-start]')?.dataset.start;
    if (!value) return;
    const v = version(state.version);
    const before = snapshot();
    let message = value === 'all' ? s('tailor.undo-all') : s('tailor.undo-none');
    if (value === 'all') state.selected = new Set(v.processes.map((p) => p.id));
    else if (value === 'none') state.selected = new Set();
    else if (value.startsWith('lc:')) {
      const lc = data.lifecycles.find((l) => l.id === value.slice(3))!;
      state.selected = new Set(lc.processes);
      state.phases = phasesOf(lc);
      state.description = lc.description;
      state.project = lc.name;
      message = s('tailor.undo-replaced', { name: lc.name });
      $<HTMLInputElement>('#project').value = state.project;
      $<HTMLTextAreaElement>('#lc-description').value = state.description;
    }
    state.excluded = new Set();
    syncPhases();
    closeStart(true);
    renderList();
    offerUndo(before, message);
  });

  $('#all').addEventListener('click', () => {
    const before = snapshot();
    state.selected = new Set(version(state.version).processes.map((p) => p.id));
    renderList();
    offerUndo(before, s('tailor.undo-all'));
  });
  $('#none').addEventListener('click', () => {
    const before = snapshot();
    state.selected = new Set();
    syncPhases();
    renderList();
    offerUndo(before, s('tailor.undo-none'));
  });

  // --- Events: tabs -------------------------------------------------------

  document.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((b) => {
    b.addEventListener('click', () => showTab(b.dataset.tab as State['tab']));
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      showTab(state.tab === 'processes' ? 'phases' : 'processes', true);
    });
  });

  $('#next-phases').addEventListener('click', () => {
    showTab('phases', true);
    $('#tab-phases').scrollIntoView({ block: 'start' });
  });

  // --- Events: phases -----------------------------------------------------

  const insertInOrder = (p: Phase, id: string) => model.insertInOrder(p, id, version(state.version));
  const newPhaseId = () => model.newPhaseId(state);

  $('#add-phase').addEventListener('click', () => {
    state.phases.push(phase({ id: newPhaseId() }));
    renderList();
    phaseList.querySelector<HTMLInputElement>('.phase-card:last-child .pc-name')?.focus();
  });

  $<HTMLTextAreaElement>('#lc-description').addEventListener('input', (e) => {
    state.description = (e.target as HTMLTextAreaElement).value;
    toHash();
  });

  const cardPhase = (el: Element) => state.phases.find((p) => p.id === el.closest<HTMLElement>('.phase-card')?.dataset.phase);

  // Typing only redraws the preview, so the field keeps the focus.
  phaseList.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    const p = cardPhase(el);
    const field = el.dataset.field as 'name' | 'description' | 'returnNote' | undefined;
    if (!p || !field || el.type === 'checkbox' || el.tagName === 'SELECT') return;
    p[field] = el.value;
    if (field === 'name') {
      // Rename the phase in the menus in place; redrawing them would lose the focus.
      const label = phaseLabel(p, state.phases.indexOf(p));
      document
        .querySelectorAll<HTMLOptionElement>(
          `#panel-processes option[value="${CSS.escape(p.id)}"], #phases option[value="${CSS.escape(p.id)}"]`,
        )
        .forEach((o) => (o.textContent = label));
      renderSummary();
    }
    renderPreview();
    toHash();
  });

  phaseList.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    const p = cardPhase(el);
    if (!p) return;
    if (el.dataset.field === 'iterative') p.iterative = el.checked;
    else if (el.dataset.field === 'returnsTo') p.returnsTo = el.value;
    else if (el.dataset.addTo && el.value) {
      for (const o of state.phases) if (o !== p) o.processes = o.processes.filter((x) => x !== el.value);
      insertInOrder(p, el.value);
    } else return;
    renderList();
  });

  phaseList.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!el) return;
    const p = cardPhase(el);
    if (!p) return;
    const i = state.phases.indexOf(p);
    if (el.dataset.move) {
      const j = i + Number(el.dataset.move);
      [state.phases[i], state.phases[j]] = [state.phases[j], state.phases[i]];
      renderList();
      // At the top or the bottom the pressed arrow is disabled, so the other one takes the focus.
      const card = `.phase-card[data-phase="${CSS.escape(p.id)}"]`;
      (
        phaseList.querySelector<HTMLButtonElement>(`${card} [data-move="${el.dataset.move}"]:not(:disabled)`) ??
        phaseList.querySelector<HTMLButtonElement>(`${card} [data-move]:not(:disabled)`)
      )?.focus();
    } else if (el.hasAttribute('data-remove')) {
      const before = snapshot();
      const name = phaseLabel(p, i);
      state.phases.splice(i, 1);
      syncPhases();
      renderList();
      offerUndo(before, s('tailor.undo-phase', { name }));
    } else if (el.dataset.unassign) {
      p.processes = p.processes.filter((x) => x !== el.dataset.unassign);
      renderList();
    }
  });

  // Drag a process between phases, or within one to change its order.
  let dragged: { id: string; from: string } | null = null;

  const panel = $('#panel-phases');
  panel.addEventListener('dragstart', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.pchip');
    if (!el) return;
    dragged = { id: el.dataset.pid!, from: el.dataset.from! };
    e.dataTransfer!.effectAllowed = 'move';
    e.dataTransfer!.setData('text/plain', dragged.id);
    requestAnimationFrame(() => el.classList.add('dragging'));
  });

  /** The chip a drop at this point goes before, or null for the end. */
  function dropBefore(zone: HTMLElement, x: number, y: number) {
    for (const c of zone.querySelectorAll<HTMLElement>('.pchip:not(.dragging)')) {
      const r = c.getBoundingClientRect();
      if (y < r.top || (y <= r.bottom && x < r.left + r.width / 2)) return c;
    }
    return null;
  }

  function clearMarks() {
    panel
      .querySelectorAll('.drop-target, .drop-before, .drop-end')
      .forEach((x) => x.classList.remove('drop-target', 'drop-before', 'drop-end'));
  }

  panel.addEventListener('dragover', (e) => {
    const zone = (e.target as HTMLElement).closest<HTMLElement>('.dropzone');
    if (!dragged || !zone) return;
    e.preventDefault();
    e.dataTransfer!.dropEffect = 'move';
    clearMarks();
    zone.classList.add('drop-target');
    const before = dropBefore(zone, e.clientX, e.clientY);
    if (before) before.classList.add('drop-before');
    else if (zone.dataset.drop) zone.classList.add('drop-end');
  });

  panel.addEventListener('dragleave', (e) => {
    if (!(e.relatedTarget instanceof Node) || !panel.contains(e.relatedTarget)) clearMarks();
  });

  panel.addEventListener('drop', (e) => {
    const zone = (e.target as HTMLElement).closest<HTMLElement>('.dropzone');
    if (!dragged || !zone) return;
    e.preventDefault();
    const before = dropBefore(zone, e.clientX, e.clientY)?.dataset.pid;
    const source = state.phases.find((p) => p.id === dragged!.from);
    if (source) source.processes.splice(source.processes.indexOf(dragged.id), 1);
    const target = state.phases.find((p) => p.id === zone.dataset.drop);
    if (target) {
      target.processes = target.processes.filter((x) => x !== dragged!.id);
      const at = before ? target.processes.indexOf(before) : -1;
      target.processes.splice(at < 0 ? target.processes.length : at, 0, dragged.id);
    }
    dragged = null;
    renderList();
  });

  panel.addEventListener('dragend', () => {
    dragged = null;
    clearMarks();
    panel.querySelectorAll('.dragging').forEach((x) => x.classList.remove('dragging'));
  });

  // --- Export -----------------------------------------------------------

  const context = () => ({ state, version: version(state.version), s, link: location.href });
  const phaseName = (p: Phase) => exporter.phaseName(state, p, s);

  function download(name: string, type: string, text: string) {
    const url = URL.createObjectURL(new Blob([text], { type }));
    const a = Object.assign(document.createElement('a'), { href: url, download: name });
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  const fileBase = () => (slug(state.project) || 'lifecycle-model') + `-${state.version}`;
  document.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((b) =>
    b.addEventListener('click', () => {
      const kind = b.dataset.export!;
      if (kind === 'md') download(`${fileBase()}.md`, 'text/markdown', exporter.markdown(context()));
      if (kind === 'csv') download(`${fileBase()}.csv`, 'text/csv', exporter.csv(context()));
      if (kind === 'json') download(`${fileBase()}.json`, 'application/json', exporter.json(context()));
      if (kind === 'yaml') download(`${slug(state.project) || 'lifecycle-model'}.yaml`, 'application/yaml', exporter.yaml(state, s));
    }),
  );

  $('#print').addEventListener('click', () => {
    const phased = state.phases.length > 0;
    $('#print-view').innerHTML =
      `<h1>${esc(state.project || s('tailor.untitled'))}</h1><p>PRM ${esc(state.version)}</p>` +
      exporter
        .groups(context())
        .map(
          (g) =>
            (phased
              ? `<h2>${esc(g.phase ? `${String(state.phases.indexOf(g.phase) + 1).padStart(2, '0')} ${phaseName(g.phase)}` : s('tailor.unassigned'))}</h2>`
              : '') +
            g.rows
              .map(
                (x) =>
                  `<h3>${x.p.id} ${esc(x.p.name)}</h3><ul>${x.activities
                    .filter((a) => a.included)
                    .map((a) => `<li>☐ ${a.id}. ${esc(a.title)}</li>`)
                    .join('')}</ul>`,
              )
              .join(''),
        )
        .join('');
    window.print();
  });

  $('#copy').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      b.textContent = s('tailor.copied');
      setTimeout(() => (b.textContent = s('tailor.copyLink')), 1500);
    } catch {
      prompt('', location.href);
    }
  });

  // --- Import -----------------------------------------------------------

  /** Replace the model being edited and show it. */
  function load(next: State) {
    state = next;
    syncPhases();
    $<HTMLInputElement>('#project').value = state.project;
    $<HTMLTextAreaElement>('#lc-description').value = state.description;
    $<HTMLSelectElement>('#version').value = state.version;
    renderStartOptions();
    renderList();
    showTab(state.tab);
  }

  const importFile = $<HTMLInputElement>('#import-file');
  const importStatus = $('#import-status');
  $('#import').addEventListener('click', () => importFile.click());

  importFile.addEventListener('change', async () => {
    const file = importFile.files?.[0];
    importFile.value = '';
    if (!file) return;
    const messages: string[] = [];
    try {
      const m = await readModel(await file.text(), file.name, {
        versions: data.versions,
        fallback: version(state.version),
        untitled: s('tailor.untitled'),
      });
      const v = data.versions.find((x) => x.id === m.version);
      if (!v) throw new ImportError(s('tailor.import-version', { v: m.version || '?' }));
      const ids = new Set(v.processes.map((p) => p.id));
      const unknown = [...new Set([...m.selected, ...m.phases.flatMap((p) => p.processes)])].filter((id) => !ids.has(id));
      const before = snapshot();
      load({
        version: v.id,
        project: m.project,
        description: m.description,
        selected: new Set(m.selected.filter((id) => ids.has(id))),
        excluded: new Set(m.excluded),
        rationale: m.rationale,
        phases: m.phases,
        tab: m.phases.length ? 'phases' : 'processes',
      });
      offerUndo(before, s('tailor.undo-replaced', { name: file.name }));
      messages.push(s('tailor.import-done', { file: file.name }));
      if (m.csv) messages.push(s('tailor.import-csv'));
      if (unknown.length) messages.push(s('tailor.import-skipped', { v: v.id, ids: unknown.join(', ') }));
    } catch (e) {
      messages.push(e instanceof ImportError ? e.message : s('tailor.import-error'));
    }
    importStatus.textContent = messages.join(' ');
    importStatus.hidden = false;
  });

  // --- Process details, in a modal --------------------------------------

  const modal = createProcessModal({
    tailor: {
      isIncluded: (id) => state.selected.has(id),
      setIncluded(id, on) {
        on ? state.selected.add(id) : state.selected.delete(id);
        syncPhases();
        renderList();
      },
      isActivityIncluded: (key) => !state.excluded.has(key),
      setActivityIncluded(key, on) {
        on ? state.excluded.delete(key) : state.excluded.add(key);
        renderList();
      },
    },
    // The list is re-rendered on every change, replacing the button.
    findOpener: (id) => list.querySelector<HTMLElement>(`[data-info="${id}"]`),
  });

  list.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-info]')?.dataset.info;
    if (!id) return;
    const p = version(state.version).processes.find((x) => x.id === id);
    modal.open(state.version, id, p?.name);
  });
  openLinksInModal(figure, modal);

  // The bar at the bottom of a narrow screen leads to the summary and the
  // exports, and steps aside once they are in view.
  new IntersectionObserver(([entry]) => ($('#mobile-bar').hidden = entry.isIntersecting)).observe($('#side'));

  // --- Start ------------------------------------------------------------

  load(state);

  const lastState = last ? model.fromHash(data, last) : null;
  if (lastState && modelKey(lastState) !== opened) {
    const done = () => {
      restore.hidden = true;
      $('#project').focus();
    };
    $('#restore-name').textContent = lastState.project || s('tailor.untitled');
    $('#restore-yes').addEventListener('click', () => {
      load(lastState);
      done();
    });
    $('#restore-no').addEventListener('click', () => {
      stored.set(null);
      done();
    });
    restore.hidden = false;
  }
</script>
