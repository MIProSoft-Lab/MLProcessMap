---
import Layout from '../../layouts/Layout.astro';
import ProcessModal from '../../components/ProcessModal.astro';
import LifecycleDiagram from '../../components/LifecycleDiagram.astro';
import '../../styles/tailor.css';
import { versions, pick } from '../../lib/content';
import { localePaths } from '../../lib/paths';
import { diagramKeys } from '../../lib/lifecycle-diagram';
import { exportKeys } from '../../lib/tailor/export';
import { builderData } from '../../lib/tailor/data';
import { renderKeys } from '../../lib/tailor/render';
import { pageLocale, href, stringsFor, type UiKey } from '../../i18n/ui';

export const getStaticPaths = localePaths;
const { locale, t } = pageLocale(Astro.props);

// Everything the script needs, for every version.
const data = builderData(locale);

// The strings of the page's script; the drawing, the exports and the templates list their own.
const keys: UiKey[] = [
  ...diagramKeys,
  ...exportKeys,
  ...renderKeys,
  'tailor.selected',
  'tailor.phases-summary',
  'tailor.bar-selected',
  'tailor.bar-missing',
  'tailor.copied',
  'tailor.copyLink',
  'tailor.untitled',
  'tailor.phase-new',
  'tailor.undo-replaced',
  'tailor.undo-all',
  'tailor.undo-none',
  'tailor.undo-phase',
  'tailor.undo-version',
  'tailor.import-done',
  'tailor.import-csv',
  'tailor.import-skipped',
  'tailor.import-version',
  'tailor.import-error',
];
const strings = stringsFor(t, keys);
---

<Layout locale={locale} title={t('tailor.title')} description={t('tailor.intro')} section="tailor" pageClass="tailor-page">
  <h1>{t('tailor.title')}</h1>
  <p class="muted prose">{t('tailor.intro')}</p>
  <noscript><p class="notice">{t('tailor.noscript')}</p></noscript>
  <p id="restore" class="notice restore no-print" role="status" hidden>
    <span>{t('tailor.restore-text')} <strong id="restore-name"></strong></span>
    <button type="button" id="restore-yes">{t('tailor.restore-yes')}</button>
    <button type="button" id="restore-no">{t('tailor.restore-no')}</button>
  </p>

  <div class="controls card no-print">
    <label>
      <span>{t('tailor.project')}</span>
      <input type="text" id="project" />
    </label>
    <label>
      <span>{t('tailor.version')}</span>
      <select id="version">
        {
          versions.map((v) => (
            <option value={v.id}>
              {v.id} · {pick(v.title, locale)}
            </option>
          ))
        }
      </select>
    </label>
    <details class="menu start-menu" id="start">
      <summary>{t('tailor.start')}…</summary>
      <ul id="start-list"></ul>
    </details>
  </div>

  <div class="layout">
    <section class="no-print">
      <div class="tabs" role="tablist">
        <button type="button" role="tab" id="tab-processes" data-tab="processes" aria-controls="panel-processes" aria-selected="true">
          {t('tailor.tab-processes')}
        </button>
        <button type="button" role="tab" id="tab-phases" data-tab="phases" aria-controls="panel-phases" aria-selected="false" tabindex="-1">
          {t('tailor.tab-phases')}
          <span id="phase-count" class="count"></span>
        </button>
      </div>

      <div id="panel-processes" role="tabpanel" aria-labelledby="tab-processes">
        <div class="bulk">
          <button type="button" id="all">{t('tailor.selectAll')}</button>
          <button type="button" id="none">{t('tailor.selectNone')}</button>
        </div>
        <ol id="processes" class="processes"></ol>
        <p class="next-step"><button type="button" id="next-phases" class="primary button">{t('tailor.next-phases')} →</button></p>
      </div>

      <div id="panel-phases" role="tabpanel" aria-labelledby="tab-phases" hidden>
        <p class="small muted prose">{t('tailor.phases-intro')}</p>
        <label class="lc-description">
          <span class="small muted">{t('tailor.lcDescription')}</span>
          <textarea id="lc-description" rows="2"></textarea>
        </label>
        <ol id="phases" class="phase-list"></ol>
        <p><button type="button" id="add-phase">+ {t('tailor.phase-add')}</button></p>
        <section class="unassigned">
          <h2 class="label">{t('tailor.unassigned')}</h2>
          <ul id="unassigned" class="pc-procs dropzone" data-drop=""></ul>
        </section>
      </div>
    </section>

    <aside class="side no-print" id="side">
      <div class="card sticky">
        <p id="summary" class="summary"></p>
        <p id="phase-summary" class="small muted" hidden></p>
        <h2>
          <span>{t('tailor.missingInputs')} <span id="missing-count" class="count"></span></span>
        </h2>
        <p id="missing-note" class="small muted" hidden>{t('tailor.missingInputsNote')}</p>
        <ul id="missing" class="missing small"></ul>
        <h2>{t('tailor.share')}</h2>
        <p class="small muted">{t('tailor.shareNote')}</p>
        <div class="exports">
          <button type="button" id="copy" class="primary button">{t('tailor.copyLink')}</button>
        </div>
        <h2>{t('tailor.export')}</h2>
        <!-- Documents are for reading; data files can be imported again below. -->
        <h3 class="export-group" id="export-documents">{t('tailor.exportDocuments')}</h3>
        <div class="exports" role="group" aria-labelledby="export-documents">
          <button type="button" data-export="md">{t('tailor.markdown')}</button>
          <button type="button" id="print">{t('tailor.print')}</button>
        </div>
        <h3 class="export-group" id="export-data">{t('tailor.exportData')}</h3>
        <p class="small muted">{t('tailor.exportDataNote')}</p>
        <div class="exports" role="group" aria-labelledby="export-data">
          <button type="button" data-export="json">{t('tailor.json')}</button>
          <button type="button" data-export="yaml" id="export-yaml" aria-describedby="yaml-note">{t('tailor.yaml')}</button>
          <button type="button" data-export="csv">{t('tailor.csv')}</button>
        </div>
        <p id="yaml-note" class="small muted">{t('tailor.yamlNote')}</p>
        <h2>{t('tailor.import')}</h2>
        <p class="small muted">{t('tailor.import-note')}</p>
        <div class="exports">
          <button type="button" id="import">{t('tailor.import-open')}</button>
          <input type="file" id="import-file" accept=".json,.yaml,.yml,.csv,application/json,application/yaml,text/csv" hidden />
        </div>
        <p id="import-status" class="small" role="status" hidden></p>
      </div>
    </aside>
  </div>

  <section id="preview-section" class="no-print" hidden>
    <h2 class="preview-title">{t('tailor.preview')}</h2>
    <p id="preview-empty" class="muted small">{t('tailor.preview-empty')}</p>
    <div id="preview">
      <LifecycleDiagram locale={locale} />
    </div>
  </section>

  <p id="undo" class="undo no-print" role="status" hidden>
    <span id="undo-text"></span>
    <button type="button" id="undo-yes">{t('tailor.undo')}</button>
    <button type="button" id="undo-close" aria-label={t('modal.close')}>✕</button>
  </p>

  <a id="mobile-bar" class="mobile-bar no-print" href="#side">
    <span id="mobile-summary"></span>
    <span class="mobile-bar-go">{t('tailor.export')} ↓</span>
  </a>

  <div id="print-view" class="print-only"></div>

  <ProcessModal locale={locale} />

  <script type="application/json" id="tailor-data" set:html={JSON.stringify({ data, strings })} />
</Layout>

<script>
  // The page's part of the builder: the model being edited, kept in the URL
  // hash so it can be shared, drawn from src/lib/tailor/render.ts and changed
  // by the events below with src/lib/tailor/model.ts.
  import { createProcessModal, openLinksInModal } from '../../lib/process-modal';
  import { animateDetailsWithin } from '../../lib/collapse';
  import { diagramSvgs } from '../../lib/lifecycle-diagram';
  import { translator } from '../../lib/client-strings';
  import * as model from '../../lib/tailor/model';
  import type { Data, Proc, State } from '../../lib/tailor/model';
  import * as exporter from '../../lib/tailor/export';
  import * as render from '../../lib/tailor/render';
  import { ImportError, readModel, toState } from '../../lib/tailor/import';
  import { rememberView } from '../../lib/tailor/view';
  import { enableDragging } from '../../lib/tailor/drag';
  import { download, lastModel } from '../../lib/tailor/browser';

  const { data, strings } = JSON.parse(document.getElementById('tailor-data')!.textContent!) as {
    data: Data;
    strings: Record<string, string>;
  };
  const s = translator(strings);
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  // --- State, kept in the URL hash so a selection can be shared ---------

  const version = (id: string) => model.versionOf(data, id);
  const current = () => version(state.version);
  /** What the templates read. */
  const view = (): render.View => ({ state, version: current(), s });

  // The last model edited is also kept in the browser, to offer it again on a
  // visit that starts without one. Opening a model does not replace it; editing does.
  const last = location.hash.length > 1 ? null : lastModel.get();

  let state = model.fromHash(data, location.hash.slice(1));

  const syncPhases = () => model.syncPhases(state, current());
  syncPhases();

  /** The model without the open tab, which is not part of it. */
  const modelKey = (x: State) => model.toHash({ ...x, tab: 'processes' });
  const opened = modelKey(state);
  let edited = false;
  const restore = $('#restore');

  const toHash = () => {
    const hash = model.toHash(state);
    history.replaceState(null, '', `#${hash}`);
    if (undo && modelKey(state) !== undo.after) dismissUndo();
    edited ||= modelKey(state) !== opened;
    if (!edited) return;
    lastModel.set(hash);
    restore.hidden = true;
  };

  // --- Undo ------------------------------------------------------------

  // An action that replaces work (a template, select all or none, a removed
  // phase, another PRM version, an imported file) can be taken back until the
  // next edit, which would otherwise be lost with it.
  let undo: { before: string; after: string } | null = null;
  const undoBar = $('#undo');
  const snapshot = () => model.toHash(state);

  function dismissUndo() {
    undo = null;
    undoBar.hidden = true;
  }

  /** Offer to return to the model as it was before an action, given what `snapshot()` returned then. */
  function offerUndo(before: string, message: string) {
    if (before === snapshot()) return;
    undo = { before, after: modelKey(state) };
    $('#undo-text').textContent = message;
    undoBar.hidden = false;
  }

  $('#undo-yes').addEventListener('click', () => {
    if (!undo) return;
    const back = model.fromHash(data, undo.before);
    dismissUndo();
    load(back);
    document.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]')?.focus();
  });
  $('#undo-close').addEventListener('click', dismissUndo);

  // --- Rendering ---------------------------------------------------------

  const list = $('#processes');
  const phaseList = $('#phases');
  // The activities of each process and the description of each phase open
  // and close like the parts of a process page, also after a redraw.
  animateDetailsWithin(list);
  animateDetailsWithin(phaseList);
  const figure = $('#preview .lc-diagram');
  const viewport = figure.querySelector<HTMLElement>('.viewport')!;

  const procOf = (id: string) => current().processes.find((p) => p.id === id);
  const unassigned = () => model.unassigned(state, current());
  // A touch screen cannot drag the process chips, so an empty phase points at the menu below it.
  const touch = matchMedia('(pointer: coarse)').matches;

  /** Draw everything again from the model, keeping the open lists and the focus. */
  function renderList() {
    const restoreView = rememberView([list, phaseList], () => $('#add-phase'));
    const v = view();
    list.innerHTML = v.version.processes.map((p) => render.processRow(v, p)).join('');
    renderPhases();
    restoreView();
  }

  function renderPhases() {
    const v = view();
    const free = unassigned();
    phaseList.innerHTML = state.phases.map((p, i) => render.phaseCard(v, p, i, { free, touch })).join('');
    $('#unassigned').innerHTML = render.unassignedChips(v, free);
    $('#phase-count').textContent = state.phases.length ? `(${state.phases.length})` : '';
    renderPreview();
    renderSummary();
  }

  function renderPreview() {
    const has = state.phases.length > 0;
    $('#preview').hidden = !has;
    $('#preview-empty').hidden = has;
    if (!has) return;
    const v = state.version;
    viewport.innerHTML = diagramSvgs(
      {
        name: state.project || s('tailor.untitled'),
        version: v,
        procHref: (id) => `${data.base}${v}/processes/${id}/`,
        phases: state.phases.map((p, i) => ({
          ...p,
          name: p.name || s('tailor.phase-new', { n: i + 1 }),
          procs: p.processes.map(procOf).filter((x): x is Proc => !!x),
        })),
      },
      s,
    );
    figure.dispatchEvent(new Event('lc-diagram:update'));
  }

  /** The counts in the sidebar and the bar at the bottom, the missing inputs, and the link. */
  function renderSummary() {
    const v = current();
    const active = (p: Proc) => model.activeActivities(state, p);
    const acts = v.processes.reduce((n, p) => n + active(p).length, 0);
    $('#summary').textContent = s('tailor.selected', { n: state.selected.size, total: v.processes.length, a: acts });
    const phaseSummary = $('#phase-summary');
    phaseSummary.hidden = !state.phases.length;
    phaseSummary.textContent = s('tailor.phases-summary', { n: state.phases.length, u: unassigned().length });
    $<HTMLButtonElement>('#export-yaml').disabled = !state.phases.length;
    for (const p of v.processes) {
      const el = list.querySelector(`[data-count="${p.id}"]`);
      if (el) el.textContent = `${active(p).length}/${p.activities.length}`;
    }
    const missing = model.missingInputs(state, v);
    $('#missing-count').textContent = missing.size ? `(${missing.size})` : '';
    $('#missing-note').hidden = !missing.size;
    $('#mobile-summary').textContent =
      s('tailor.bar-selected', { n: state.selected.size, total: v.processes.length }) +
      (missing.size ? ` · ${s('tailor.bar-missing', { m: missing.size })}` : '');
    $('#missing').innerHTML = render.missingList(view(), missing);
    toHash();
  }

  function showTab(tab: State['tab'], focus = false) {
    state.tab = tab;
    document.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((b) => {
      const on = b.dataset.tab === tab;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      if (on && focus) b.focus();
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !on;
    });
    // The preview spans the page, below the editor and the sidebar.
    $('#preview-section').hidden = tab !== 'phases';
    toHash();
  }

  /** Replace the model being edited and show it. */
  function load(next: State) {
    state = next;
    syncPhases();
    $<HTMLInputElement>('#project').value = state.project;
    $<HTMLTextAreaElement>('#lc-description').value = state.description;
    $<HTMLSelectElement>('#version').value = state.version;
    $('#start-list').innerHTML = render.startOptions(data, state, s);
    renderList();
    showTab(state.tab);
  }

  // --- Events: processes --------------------------------------------------

  list.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.proc) {
      el.checked ? state.selected.add(el.dataset.proc) : state.selected.delete(el.dataset.proc);
      syncPhases();
      renderList();
    } else if (el.dataset.act) {
      el.checked ? state.excluded.delete(el.dataset.act) : state.excluded.add(el.dataset.act);
      renderSummary();
    } else if (el.dataset.phaseOf) {
      model.assignToPhase(state, el.dataset.phaseOf, el.value, current());
      renderList();
    }
  });

  list.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.why) {
      state.rationale[el.dataset.why] = el.value;
      toHash();
    }
  });

  $('#missing').addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).dataset.add;
    if (!id) return;
    state.selected.add(id);
    renderList();
    // The button that was pressed is gone: move on to the next one, or to the process just added.
    ($('#missing').querySelector<HTMLElement>('button') ?? list.querySelector<HTMLElement>(`[data-proc="${id}"]`))?.focus();
  });

  $<HTMLInputElement>('#project').addEventListener('input', (e) => {
    state.project = (e.target as HTMLInputElement).value;
    if (state.phases.length) renderPreview();
    toHash();
  });

  $<HTMLSelectElement>('#version').addEventListener('change', (e) => {
    const before = snapshot();
    state = model.inVersion(state, version((e.target as HTMLSelectElement).value));
    syncPhases();
    $('#start-list').innerHTML = render.startOptions(data, state, s);
    renderList();
    offerUndo(before, s('tailor.undo-version', { v: state.version }));
  });

  // The "Start from" menu: each item replaces the selection, and a template the phases too.
  const startMenu = $<HTMLDetailsElement>('#start');
  const closeStart = (focus = false) => {
    startMenu.open = false;
    if (focus) startMenu.querySelector('summary')!.focus();
  };
  document.addEventListener('click', (e) => {
    if (startMenu.open && !startMenu.contains(e.target as Node)) closeStart();
  });
  startMenu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && startMenu.open) closeStart(true);
  });

  $('#start-list').addEventListener('click', (e) => {
    const choice = (e.target as HTMLElement).closest<HTMLElement>('[data-start]')?.dataset.start;
    if (!choice) return;
    const before = snapshot();
    const lc = model.startFrom(state, choice, data);
    if (lc) {
      $<HTMLInputElement>('#project').value = state.project;
      $<HTMLTextAreaElement>('#lc-description').value = state.description;
    }
    closeStart(true);
    renderList();
    offerUndo(before, lc ? s('tailor.undo-replaced', { name: lc.name }) : choice === 'all' ? s('tailor.undo-all') : s('tailor.undo-none'));
  });

  $('#all').addEventListener('click', () => {
    const before = snapshot();
    state.selected = new Set(current().processes.map((p) => p.id));
    renderList();
    offerUndo(before, s('tailor.undo-all'));
  });
  $('#none').addEventListener('click', () => {
    const before = snapshot();
    state.selected = new Set();
    syncPhases();
    renderList();
    offerUndo(before, s('tailor.undo-none'));
  });

  // --- Events: tabs -------------------------------------------------------

  document.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((b) => {
    b.addEventListener('click', () => showTab(b.dataset.tab as State['tab']));
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      showTab(state.tab === 'processes' ? 'phases' : 'processes', true);
    });
  });

  $('#next-phases').addEventListener('click', () => {
    showTab('phases', true);
    $('#tab-phases').scrollIntoView({ block: 'start' });
  });

  // --- Events: phases -----------------------------------------------------

  $('#add-phase').addEventListener('click', () => {
    state.phases.push(model.phase({ id: model.newPhaseId(state) }));
    renderList();
    phaseList.querySelector<HTMLInputElement>('.phase-card:last-child .pc-name')?.focus();
  });

  $<HTMLTextAreaElement>('#lc-description').addEventListener('input', (e) => {
    state.description = (e.target as HTMLTextAreaElement).value;
    toHash();
  });

  const cardPhase = (el: Element) => state.phases.find((p) => p.id === el.closest<HTMLElement>('.phase-card')?.dataset.phase);

  // Typing only redraws the preview, so the field keeps the focus.
  phaseList.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    const p = cardPhase(el);
    const field = el.dataset.field as 'name' | 'description' | 'returnNote' | undefined;
    if (!p || !field || el.type === 'checkbox' || el.tagName === 'SELECT') return;
    p[field] = el.value;
    if (field === 'name') {
      // Rename the phase in the menus in place; redrawing them would lose the focus.
      const label = render.phaseLabel(p, state.phases.indexOf(p), s);
      document
        .querySelectorAll<HTMLOptionElement>(
          `#panel-processes option[value="${CSS.escape(p.id)}"], #phases option[value="${CSS.escape(p.id)}"]`,
        )
        .forEach((o) => (o.textContent = label));
      renderSummary();
    }
    renderPreview();
    toHash();
  });

  phaseList.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    const p = cardPhase(el);
    if (!p) return;
    if (el.dataset.field === 'iterative') p.iterative = el.checked;
    else if (el.dataset.field === 'returnsTo') p.returnsTo = el.value;
    else if (el.dataset.addTo && el.value) model.assignToPhase(state, el.value, p.id, current());
    else return;
    renderList();
  });

  phaseList.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!el) return;
    const p = cardPhase(el);
    if (!p) return;
    const i = state.phases.indexOf(p);
    if (el.dataset.move) {
      model.movePhase(state, i, Number(el.dataset.move));
      renderList();
      // At the top or the bottom the pressed arrow is disabled, so the other one takes the focus.
      const card = `.phase-card[data-phase="${CSS.escape(p.id)}"]`;
      (
        phaseList.querySelector<HTMLButtonElement>(`${card} [data-move="${el.dataset.move}"]:not(:disabled)`) ??
        phaseList.querySelector<HTMLButtonElement>(`${card} [data-move]:not(:disabled)`)
      )?.focus();
    } else if (el.hasAttribute('data-remove')) {
      const before = snapshot();
      const name = render.phaseLabel(p, i, s);
      state.phases.splice(i, 1);
      syncPhases();
      renderList();
      offerUndo(before, s('tailor.undo-phase', { name }));
    } else if (el.dataset.unassign) {
      p.processes = p.processes.filter((x) => x !== el.dataset.unassign);
      renderList();
    }
  });

  // Drag a process between phases, or within one to change its order.
  enableDragging($('#panel-phases'), (id, from, to, before) => {
    model.moveProcess(state, id, from, to, before);
    renderList();
  });

  // --- Export -----------------------------------------------------------

  const context = () => ({ state, version: current(), s, link: location.href });
  const fileBase = () => (model.slug(state.project) || 'lifecycle-model') + `-${state.version}`;

  document.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((b) =>
    b.addEventListener('click', () => {
      const kind = b.dataset.export!;
      if (kind === 'md') download(`${fileBase()}.md`, 'text/markdown', exporter.markdown(context()));
      if (kind === 'csv') download(`${fileBase()}.csv`, 'text/csv', exporter.csv(context()));
      if (kind === 'json') download(`${fileBase()}.json`, 'application/json', exporter.json(context()));
      if (kind === 'yaml') download(`${model.slug(state.project) || 'lifecycle-model'}.yaml`, 'application/yaml', exporter.yaml(state, s));
    }),
  );

  $('#print').addEventListener('click', () => {
    $('#print-view').innerHTML = render.printView(view());
    window.print();
  });

  $('#copy').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      b.textContent = s('tailor.copied');
      b.classList.add('copied');
      setTimeout(() => {
        b.textContent = s('tailor.copyLink');
        b.classList.remove('copied');
      }, 1500);
    } catch {
      prompt('', location.href);
    }
  });

  // --- Import -----------------------------------------------------------

  const importFile = $<HTMLInputElement>('#import-file');
  const importStatus = $('#import-status');
  $('#import').addEventListener('click', () => importFile.click());

  importFile.addEventListener('change', async () => {
    const file = importFile.files?.[0];
    importFile.value = '';
    if (!file) return;
    const messages: string[] = [];
    try {
      const m = await readModel(await file.text(), file.name, {
        versions: data.versions,
        fallback: current(),
        untitled: s('tailor.untitled'),
      });
      const v = data.versions.find((x) => x.id === m.version);
      if (!v) throw new ImportError(s('tailor.import-version', { v: m.version || '?' }));
      const { state: next, unknown } = toState(m, v);
      const before = snapshot();
      load(next);
      offerUndo(before, s('tailor.undo-replaced', { name: file.name }));
      messages.push(s('tailor.import-done', { file: file.name }));
      if (m.csv) messages.push(s('tailor.import-csv'));
      if (unknown.length) messages.push(s('tailor.import-skipped', { v: v.id, ids: unknown.join(', ') }));
    } catch (e) {
      messages.push(e instanceof ImportError ? e.message : s('tailor.import-error'));
    }
    importStatus.textContent = messages.join(' ');
    importStatus.hidden = false;
  });

  // --- Process details, in a modal --------------------------------------

  const modal = createProcessModal({
    tailor: {
      isIncluded: (id) => state.selected.has(id),
      setIncluded(id, on) {
        on ? state.selected.add(id) : state.selected.delete(id);
        syncPhases();
        renderList();
      },
      isActivityIncluded: (key) => !state.excluded.has(key),
      setActivityIncluded(key, on) {
        on ? state.excluded.delete(key) : state.excluded.add(key);
        renderList();
      },
    },
    // The list is re-rendered on every change, replacing the button.
    findOpener: (id) => list.querySelector<HTMLElement>(`[data-info="${id}"]`),
  });

  list.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-info]')?.dataset.info;
    if (id) modal.open(state.version, id, procOf(id)?.name);
  });
  openLinksInModal(figure, modal);

  // The bar at the bottom of a narrow screen leads to the summary and the
  // exports, and steps aside once they are in view.
  new IntersectionObserver(([entry]) => ($('#mobile-bar').hidden = entry.isIntersecting)).observe($('#side'));

  // --- Start ------------------------------------------------------------

  load(state);

  const lastState = last ? model.fromHash(data, last) : null;
  if (lastState && modelKey(lastState) !== opened) {
    const done = () => {
      restore.hidden = true;
      $('#project').focus();
    };
    $('#restore-name').textContent = lastState.project || s('tailor.untitled');
    $('#restore-yes').addEventListener('click', () => {
      load(lastState);
      done();
    });
    $('#restore-no').addEventListener('click', () => {
      lastModel.set(null);
      done();
    });
    restore.hidden = false;
  }
</script>
