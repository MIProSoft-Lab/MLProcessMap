---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LifecyclePhases from '../../../components/LifecyclePhases.astro';
import LifecycleDiagram from '../../../components/LifecycleDiagram.astro';
import ProcessModal from '../../../components/ProcessModal.astro';
import ProcessChip from '../../../components/ProcessChip.astro';
import { getLifecycle, getProcess, processIds } from '../../../lib/content';
import { lifecyclePaths } from '../../../lib/paths';
import { prose } from '../../../lib/acronyms';
import { plain } from '../../../lib/text';
import { pageLocale, href } from '../../../i18n/ui';

export const getStaticPaths = lifecyclePaths;
const { locale, t } = pageLocale(Astro.props);
const { id } = Astro.params as { id: string };
const { data: l, translated } = getLifecycle(id, locale);
const included = new Set(l.phases.flatMap((p) => p.processes));
const missing = processIds(l.prmVersion).filter((pid) => !included.has(pid));
---

<Layout
  locale={locale}
  title={l.name}
  description={l.description ? plain(l.description) : t('lc.intro')}
  section="lifecycles"
  translated={translated}
>
  <Breadcrumbs locale={locale} items={[{ text: t('lc.title'), href: href(locale, 'lifecycles') }, { text: l.name }]} />
  <h1>{l.name}</h1>
  <div class="meta">
    {l.status === 'draft' && <span class="badge">{t('lc.draft')}</span>}
    <a class="badge" href={href(locale, l.prmVersion)}>{t('lc.basedOn', { version: l.prmVersion })}</a>
    {
      l.source && (
        <span class="small muted">
          {t('lc.source')}: {l.source}
        </span>
      )
    }
  </div>
  {l.description && <p class="prose" set:html={prose(l.description, locale)} />}

  <LifecycleDiagram locale={locale} lifecycle={l} />

  <h2>{t('lc.phases')}</h2>
  <LifecyclePhases locale={locale} lifecycle={l} />

  {
    missing.length > 0 && (
      <section>
        <h2>{t('lc.notCovered')}</h2>
        <div class="chips">
          {missing.map((pid) => (
            <ProcessChip locale={locale} version={l.prmVersion} id={pid} name={getProcess(l.prmVersion, pid, locale).data.name} />
          ))}
        </div>
      </section>
    )
  }

  <p class="no-print">
    <a class="button primary" href={`${href(locale, 'tailor')}#v=${l.prmVersion}&lc=${l.id}`}>{t('lc.useInTailor')} →</a>
  </p>
  <ProcessModal locale={locale} openLinksIn="main" />
</Layout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
  }

  a.badge {
    text-decoration: none;
  }

  section {
    margin-bottom: 24px;
  }
</style>
