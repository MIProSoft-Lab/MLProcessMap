---
import '../styles/global.css';
import { site, pick, versions, defaultVersion, contentFiles } from '../lib/content';
import { validateOnce, formatIssues, errors } from '../lib/validation';
import { edition, otherEditionUrl } from '../lib/edition';
import pkg from '../../package.json';
import ProcessHover from '../components/ProcessHover.astro';
import AcronymHover from '../components/AcronymHover.astro';
import { useTranslations, languageNames, languageIn, locales, defaultLocale, href, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  section?: 'processes' | 'workProducts' | 'lifecycles' | 'tailor' | 'compare' | 'references';
  /** Current PRM version and where each version's equivalent page lives. */
  version?: string;
  versionLinks?: Record<string, string>;
  /** False when the page shows English text in place of a missing translation. */
  translated?: boolean;
  /** False on pages without a fixed address, such as the error page, to leave out the canonical and language links. */
  indexable?: boolean;
  /** Class for <main>, which the page's own stylesheet starts its rules with. */
  pageClass?: string;
}

const { locale, title, description, section, version, versionLinks, translated = true, indexable = true, pageClass } = Astro.props;
const t = useTranslations(locale);
const siteTitle = pick(site.title, locale);
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
// Search results and link previews show about 160 characters; cut longer text at a word.
const fullDescription = (description ?? pick(site.intro, locale)).replace(/\s+/g, ' ').trim();
const metaDescription = fullDescription.length <= 200 ? fullDescription : `${fullDescription.slice(0, 197).replace(/\s+\S*$/, '')}…`;
// Region for each language, as Open Graph expects (en_GB, es_ES, ca_ES).
const ogLocale = (l: Locale) => ({ en: 'en_GB', es: 'es_ES', ca: 'ca_ES' })[l] ?? l;

// Fail the build on content errors, checked once per set of content files.
// Warnings are left to npm run check:content.
const issues = errors(validateOnce(contentFiles));
if (issues.length) throw new Error(`Content errors (run npm run check:content to list them again):\n\n${formatIssues(issues)}`);

// Same page in the other languages.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// A page without a fixed address, such as the error page, offers the home page in the other languages.
const rest = indexable ? Astro.url.pathname.slice(base.length).split('/').slice(2).join('/') : '';
const languageLinks = locales.map((l) => ({ locale: l, href: `${base}/${l}/${rest}` }));

const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = absolute(`${base}/${locale}/${rest}`);
const defaultLanguageLink = languageLinks.find((l) => l.locale === defaultLocale)!.href;

const navVersion = version ?? defaultVersion;
// The same page under /latest/, which always forwards to the default version.
const latestLink = versionLinks?.[defaultVersion]?.replace(`/${locale}/${defaultVersion}/`, `/${locale}/latest/`);
const nav = [
  ['processes', href(locale, navVersion)],
  ['workProducts', href(locale, navVersion, 'work-products')],
  ['lifecycles', href(locale, 'lifecycles')],
  ['tailor', href(locale, 'tailor')],
  ['references', href(locale, 'references')],
] as const;
// The section of the page, which the menu on a narrow screen is named after.
const currentSection = nav.find(([key]) => key === section)?.[0];
const repo = import.meta.env.PUBLIC_REPO ? `https://github.com/${import.meta.env.PUBLIC_REPO}` : undefined;
const otherEdition = otherEditionUrl && `${otherEditionUrl}${locale}/`;
// Comments go to the issues of the repository, or by email without one.
const feedback = repo ? `${repo}/issues/new` : site.email ? `mailto:${site.email}` : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {/* Title card when a link is shared in chat or on social media. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale(l)} />)}
    {indexable && Astro.site && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {/* Searches lead to the live edition; the thesis edition is reached from the thesis. */}
    {(edition === 'thesis' || !indexable) && <meta name="robots" content="noindex" />}
    {
      indexable && (
        <>
          <link rel="canonical" href={canonical} />
          {languageLinks.map((l) => (
            <link rel="alternate" hreflang={l.locale} href={absolute(l.href)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(defaultLanguageLink)} />
        </>
      )
    }
    <script is:inline>
      // Apply the saved theme before the first paint. Without a saved choice
      // the page follows the system setting through prefers-color-scheme.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    {
      edition === 'thesis' && (
        <div class="edition-banner">
          <div class="container">
            <span class="label">{t('edition.thesis')}</span>
            <span>{t('edition.banner')}</span>
            {otherEdition && <a href={otherEdition}>{t('edition.goLive')} →</a>}
          </div>
        </div>
      )
    }
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={href(locale)}>
          <span class="brand-code" aria-hidden="true">ML-PRM</span>
          <span>{siteTitle}</span>
        </a>
        <div class="switchers">
          {
            version && versionLinks && (
              <details class="menu">
                <summary aria-label={`${t('nav.version')}: ${version}`}>
                  {version}
                  {version === defaultVersion && <span class="menu-note">· {t('nav.latest')}</span>}
                </summary>
                <ul>
                  {latestLink && (
                    <li>
                      <a href={latestLink} data-version-link={defaultVersion}>
                        <span class="menu-key">{t('nav.latest')}</span>
                        <span class="menu-note">{defaultVersion}</span>
                      </a>
                    </li>
                  )}
                  {versions.map((v) =>
                    versionLinks[v.id] ? (
                      <li>
                        <a href={versionLinks[v.id]} aria-current={v.id === version ? 'true' : undefined} data-version-link={v.id}>
                          <span class="menu-key">{v.id}</span>
                          <span class="menu-note">{pick(v.title, locale)}</span>
                        </a>
                      </li>
                    ) : null,
                  )}
                </ul>
              </details>
            )
          }
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            data-label-dark={t('nav.theme-dark')}
            data-label-light={t('nav.theme-light')}
            aria-label={t('nav.theme-dark')}
            title={t('nav.theme-dark')}
          >
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
              <path
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
            </svg>
          </button>
          <details class="menu">
            <summary aria-label={`${t('nav.language')}: ${languageNames[locale]}`}>{locale.toUpperCase()}</summary>
            <ul>
              {
                languageLinks.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      hreflang={l.locale}
                      lang={l.locale}
                      aria-current={l.locale === locale ? 'true' : undefined}
                      data-same-page={indexable ? '' : undefined}
                    >
                      <span class="menu-key">{l.locale.toUpperCase()}</span>
                      <span class="menu-note">{languageNames[l.locale]}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </div>
      <nav class="main-nav" aria-label={t('nav.main')}>
        <div class="container">
          {
            /* On a narrow screen, where the sections do not fit side by side: a menu
              named after the current section (global.css shows one or the other). */
          }
          <details class="menu section-menu">
            <summary>
              <span class="section-menu-icon" aria-hidden="true">☰</span>
              {currentSection ? t(`nav.${currentSection}`) : t('nav.menu')}
            </summary>
            <ul>
              {
                nav.map(([key, url]) => (
                  <li>
                    <a href={url} aria-current={section === key ? 'page' : undefined}>
                      {t(`nav.${key}`)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
          <ul class="section-tabs">
            {
              nav.map(([key, url]) => (
                <li>
                  <a href={url} aria-current={section === key ? 'page' : undefined}>
                    {t(`nav.${key}`)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </header>
    <main id="main" class={pageClass}>
      <div class="container">
        {!translated && <p class="notice">{t('i18n.untranslated', { language: languageIn(locale, locale) })}</p>}
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="title-block">
          <div>
            <span class="label">{t('footer.thesis')}</span>
            {site.author}
            {
              site.email && (
                <>
                  <br />
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </>
              )
            }
          </div>
          {
            site.institution && (
              <div>
                <span class="label">{t('footer.institution')}</span>
                {site.institution}
              </div>
            )
          }
          <div>
            <span class="label">{t('footer.licence')}</span>
            <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">{t('footer.license')}</a>
          </div>
          <div>
            <span class="label">{t('footer.links')}</span>
            {
              [
                repo && <a href={repo}>{t('footer.source')}</a>,
                feedback && <a href={feedback}>{t('footer.feedback')}</a>,
                edition === 'live' && otherEdition && <a href={otherEdition}>{t('edition.thesisLink')}</a>,
              ]
                .filter(Boolean)
                .map((link, i) => (
                  <>
                    {i > 0 && ' · '}
                    {link}
                  </>
                ))
            }
          </div>
        </div>
        <p class="footer-meta">
          {
            repo ? (
              <a href={`${repo}/releases`}>
                {siteTitle} {t('footer.version', { v: pkg.version })}
              </a>
            ) : (
              <span>
                {siteTitle} {t('footer.version', { v: pkg.version })}
              </span>
            )
          }
          {' · '}
          <a href={`${base}/admin/`} data-astro-prefetch="false">{t('nav.admin')}</a>
        </p>
      </div>
    </footer>
    {/* Before the script below, which sets it up. */}
    {
      version && versionLinks && (
        <dialog id="version-change" class="version-change" aria-labelledby="vc-title">
          <form method="dialog">
            <h2 id="vc-title">{t('nav.versionChange')}</h2>
            <p class="vc-text" data-text={t('nav.versionQuestion')} />
            <p class="vc-actions">
              <button value="apply" class="primary button">
                {t('nav.versionApply')}
              </button>
              <button value="reset" class="button">
                {t('nav.versionReset')}
              </button>
              <button value="cancel" class="link">
                {t('nav.versionCancel')}
              </button>
            </p>
          </form>
        </dialog>
      )
    }
    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        const root = document.documentElement;
        const system = matchMedia('(prefers-color-scheme: dark)');
        const current = () => root.dataset.theme || (system.matches ? 'dark' : 'light');
        const sync = () => {
          const label = current() === 'dark' ? button.dataset.labelLight : button.dataset.labelDark;
          button.setAttribute('aria-label', label);
          button.title = label;
          button.dataset.current = current();
        };
        button.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          const apply = () => {
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {}
            sync();
          };
          // Cross-fade between the two themes, like between pages (see the
          // view transition in global.css), where the browser can.
          if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.startViewTransition(apply);
          } else {
            apply();
          }
        });
        system.addEventListener('change', sync);
        sync();
      })();
      // On a narrow screen the main menu scrolls sideways: bring the current
      // section into view and fade the side that has more items.
      (() => {
        const list = document.querySelector('.main-nav .section-tabs');
        const current = list.querySelector('[aria-current="page"]');
        if (current) {
          const item = current.getBoundingClientRect();
          const box = list.getBoundingClientRect();
          list.scrollLeft += item.left - box.left - (box.width - item.width) / 2;
        }
        const sync = () => {
          const max = list.scrollWidth - list.clientWidth;
          list.dataset.fade = max <= 1 ? '' : (list.scrollLeft > 1 ? 's' : '') + (list.scrollLeft < max - 1 ? 'e' : '');
        };
        list.addEventListener('scroll', sync, { passive: true });
        addEventListener('resize', sync);
        sync();
      })();
      // Remember a language chosen in the menu, so the root address opens in it next time.
      document.querySelectorAll('.site-header a[hreflang]').forEach((a) =>
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('lang', a.hreflang);
          } catch {}
        }),
      );
      // The same page in another language keeps what the address holds: a search
      // (?q=), the options of the printable version, the model of the builder
      // (#…). Pages change their address as they are used, so it is copied when
      // a link is about to be followed: pressed, focused or clicked, also to open
      // it in a new tab.
      document.querySelectorAll('.site-header a[hreflang][data-same-page]').forEach((a) => {
        const carry = () => {
          a.search = location.search;
          a.hash = location.hash;
        };
        for (const type of ['pointerdown', 'focus', 'click']) a.addEventListener(type, carry);
      });
      // Close the header menus on a click outside them or on Escape.
      (() => {
        const menus = [...document.querySelectorAll('.site-header details.menu')];
        document.addEventListener('click', (e) => {
          for (const m of menus) if (m.open && !m.contains(e.target)) m.open = false;
        });
        document.addEventListener('keydown', (e) => {
          const m = menus.find((x) => x.open);
          if (e.key !== 'Escape' || !m) return;
          m.open = false;
          m.querySelector('summary').focus();
        });
        // Opening one menu closes the other.
        for (const m of menus) m.addEventListener('toggle', () => m.open && menus.forEach((x) => x !== m && (x.open = false)));
      })();
      // Another PRM version from the menu, when the address holds the user's
      // changes (?…: a search, the options of the printable version): ask
      // whether to try them on the other version or to start again. A click
      // that opens a new tab is left alone, without the changes.
      (() => {
        const dialog = document.getElementById('version-change');
        if (!dialog) return;
        const text = dialog.querySelector('.vc-text');
        let target = null;
        document.querySelectorAll('.site-header a[data-version-link]').forEach((a) =>
          a.addEventListener('click', (e) => {
            if (!location.search || a.getAttribute('aria-current') === 'true') return;
            if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            a.closest('details').open = false;
            target = a;
            text.textContent = text.dataset.text.replace('{version}', a.dataset.versionLink);
            // Escape closes it without an answer: clear the one from last time.
            dialog.returnValue = '';
            dialog.showModal();
          }),
        );
        dialog.addEventListener('close', () => {
          if (!target || !dialog.returnValue || dialog.returnValue === 'cancel') return (target = null);
          const url = new URL(target.href);
          if (dialog.returnValue === 'apply') {
            url.search = location.search;
            url.hash = location.hash;
          }
          location.href = url.href;
        });
      })();
    </script>
    <ProcessHover locale={locale} />
    <AcronymHover />
  </body>
</html>
